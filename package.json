{
  "name": "bookstacks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "exports": "python scripts/build_exports.py --all",
    "epubs": "node scripts/publish_epubs.mjs",
    "exports:sample": "python scripts/build_exports.py --file tei/shakespeare/shakespeare_alls-well-that-ends-well_fra.xml",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lucide/astro": "1.61.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "astro": "7.4.2",
    "fflate": "0.8.3",
    "material-icons": "1.13.14",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
