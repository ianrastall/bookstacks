---
import T from './InterfaceText.astro';
import {text} from '../lib/interface';
import type {Edition} from '../lib/library';
import type {Locale} from '../lib/i18n';
interface Props{edition:Edition;locale:Locale;unitPath:string}
const {edition,locale,unitPath}=Astro.props;
const publication=edition.epub;
---
{publication&&<section id="epub-reader" class="epub-reading-content" data-epub-pane data-epub-publication={JSON.stringify(publication)} data-epub-start={unitPath} lang={edition.code} translate="no" hidden>
  <div class="epub-tools" lang={locale} translate="yes">
    <button type="button" data-epub-previous disabled><T locale={locale} k="previous" /></button>
    <label class="epub-contents-label"><T locale={locale} k="contents" /><select data-epub-contents disabled><option>—</option></select></label>
    <button type="button" data-epub-next disabled><T locale={locale} k="next" /></button>
    <a href={`${publication.href}?revision=${publication.revision}`} download={publication.href.split('/').pop()}><T locale={locale} k="downloads" /> · EPUB</a>
    <div class="epub-size"><span><T locale={locale} k="textSize" /></span><button type="button" data-epub-smaller aria-label={text(locale,'decreaseText')} data-i18n-aria-label="decreaseText">A−</button><output data-epub-size>100%</output><button type="button" data-epub-larger aria-label={text(locale,'increaseText')} data-i18n-aria-label="increaseText">A+</button></div>
    <form data-epub-find-form><label><T locale={locale} k="pdfFind" /><input type="search" data-epub-find /></label><button type="submit"><T locale={locale} k="next" /></button></form>
  </div>
  <progress data-epub-loading aria-label={text(locale,'readEpub')} data-i18n-aria-label="readEpub"></progress>
  <p data-epub-error role="status" lang={locale} hidden><T locale={locale} k="epubError" /></p>
  <p data-epub-no-match role="status" lang={locale} hidden><T locale={locale} k="pdfNoMatches" /></p>
  <div data-epub-host></div>
</section>}
<script>import '../scripts/epub-reader';</script>
<style>
  .epub-reading-content{min-width:0;border:1px solid var(--border);border-radius:4px;overflow:hidden;background:var(--panel);}
  .epub-tools{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:12px;border-bottom:1px solid var(--border);font:14px var(--sans-font);}
  label,.epub-size{display:flex;align-items:center;gap:6px;min-width:0;}.epub-contents-label{flex:1;min-width:110px;}
  input,select,button{min-width:0;max-width:100%;padding:6px;color:var(--text);background:var(--input);border:1px solid var(--control-border);border-radius:4px;font:inherit;}
  select{width:100%;}form{display:flex;gap:8px;flex:1 1 100%;}form label{flex:1;}input{width:100%;}
  progress{display:block;margin:12px;width:calc(100% - 24px);}p{padding:0 12px;}
  [data-epub-host]{position:relative;width:100%;min-height:4rem;}
  :global(.epub-reading-frame){display:block;width:100%;border:0;min-height:8rem;}
  @media(max-width:600px){.epub-contents-label{order:-1;flex:1 1 100%;}}
</style>
