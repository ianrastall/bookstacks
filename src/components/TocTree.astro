---
import type { TocNode } from '../lib/library';

interface Props {
  nodes: TocNode[];
}

const { nodes } = Astro.props;
---

<ol class="toc-list">
  {nodes.map((node) => (
    <li class:list={['toc-item', { 'toc-group': !node.href }]}>
      {node.href ? (
        <a class="toc-link" href={node.href}>
          <span>{node.label}</span>
          <span class="toc-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="toc-section-title">
          <span>{node.label}</span>
          <span class="toc-kind">{node.kind.replaceAll('_', ' ')}</span>
        </div>
      )}
      {node.children.length > 0 && <Astro.self nodes={node.children} />}
    </li>
  ))}
</ol>
