---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorPortrait from './AuthorPortrait.astro';
import { getCatalogueLibrary, localizedEditionHref, localizedUnitHref, pdfReadingHref, hasEmbeddedPdf, type Author } from '../lib/library';
import T from './InterfaceText.astro';
import { editionDirection, editionLanguageName, type Locale } from '../lib/i18n';
interface Props { author: Author; locale?: Locale }
const {author,locale='en'}=Astro.props;
const catalogueAuthor = getCatalogueLibrary().authors.find(item => item.slug === author.slug) ?? author;
---
<BaseLayout title={author.name} locale={locale}>
 <section class="tool-container shell">
  <h1>{author.name}</h1><p class="author-dates">{author.dates}</p>
  <div class="author-hero"><AuthorPortrait author={author} /></div>
  <div class="tool-grid">
   {catalogueAuthor.works.map(work=><article class="tool-card book-card">
    <h2 lang="en" dir="ltr">{work.title}</h2>
    <ul class="edition-list">{work.editions.map(edition=><li>
     <a class="book-card-main" href={localizedEditionHref(work,edition)} lang={edition.code} dir={editionDirection(edition.code)} translate="no">{edition.sourceTitle}</a>
     <span class="edition-language" lang={edition.code} dir={editionDirection(edition.code)} translate="no">{editionLanguageName(edition)}</span>
     <div class="book-reading-links">
       {edition.units[0] && <a href={localizedUnitHref(work,edition,edition.units[0])}><T locale={locale} k="readOnline" /></a>}
       {hasEmbeddedPdf(edition) && <a href={pdfReadingHref(work,edition)}><T locale={locale} k="readPdf" /></a>}
     </div>
    </li>)}</ul>
   </article>)}
  </div>
 </section>
</BaseLayout>
