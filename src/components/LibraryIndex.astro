---
import T from './InterfaceText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { text } from '../lib/interface';
import AuthorPortrait from './AuthorPortrait.astro';
import { getLibrary } from '../lib/library';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const library = getLibrary();
const authors = library.authors;
const editionCount = authors.reduce((sum,author)=>sum+author.works.reduce((n,work)=>n+work.editions.length,0),0);
const libraryDescription = text(locale,'editionCount',[editionCount]);
---

<BaseLayout title={text(locale,"authors")} titleKey="authors" description={libraryDescription} locale={locale}>
  <section class="tool-container shell" style="margin-top: 2rem;">
    <h1 class="visually-hidden"><T locale={locale} k="authors" /></h1>
    <div class="tool-header">
      <div class="tool-title">
        <span class="material-icons" aria-hidden="true">library_books</span>
        <h2><T locale={locale} k="authors" /></h2>
      </div>
    </div>
    <p class="tool-description"><T locale={locale} k="editionCount" args={[editionCount]} /></p><div class="author-filter"><label for="author-search"><T locale={locale} k="searchAuthorsTitles" /></label><input id="author-search" type="search" disabled /></div><p id="author-empty" hidden><T locale={locale} k="noMatchingBooks" /></p>
    {authors.length > 0 ? (
      <div class="tool-grid author-grid">
        {authors.map((author) => {
          const editionTotal = author.works.reduce((sum,work)=>sum+work.editions.length,0);
          return (
            <a class="tool-card author-card" data-author-search={`${author.name} ${author.works.flatMap(work=>[work.title,...work.editions.map(e=>e.sourceTitle)]).join(' ')}`} href={`/authors/${author.slug}`}>
              <div class="author-card-media">
                <AuthorPortrait author={author} lazy />
              </div>
              <div class="author-card-body">
                <h3 class="author-name">{author.name}</h3>
                <p class="author-dates">{author.dates}</p>
                <p class="author-book-count"><T locale={locale} k="bookCount" args={[author.works.length]} /> · <T locale={locale} k="editionCount" args={[editionTotal]} /></p>
              </div>
            </a>
          );
        })}
      </div>
    ) : <p class="empty-state"><T locale={locale} k="noBooks" /></p>}
  </section>
</BaseLayout>

<script>
 import { matchesSearch } from '../lib/catalogue';
 const search=document.querySelector<HTMLInputElement>('#author-search')!;search.disabled=false;search.addEventListener('input',()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-author-search]').forEach(card=>{card.hidden=!matchesSearch(card.dataset.authorSearch||'',search.value);if(!card.hidden)count++;});document.querySelector<HTMLElement>('#author-empty')!.hidden=!!count;});
</script>
