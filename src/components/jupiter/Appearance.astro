---
import T from '../InterfaceText.astro';
import { Settings2, X } from '@lucide/astro';
import { jupiterUi } from '../../lib/jupiter-ui';
import type { Locale } from '../../lib/i18n';
interface Props { locale:Locale; }
const {locale}=Astro.props;
const t=jupiterUi(locale);
---
<button id="appearance-open" disabled type="button" class="appearance-trigger" aria-haspopup="dialog"><Settings2 size={17} aria-hidden="true" /><span><T locale={locale} k="j.0" /></span></button>
<dialog id="appearance-dialog" aria-labelledby="appearance-title">
  <div class="dialog-heading"><div><p class="eyebrow"><T locale={locale} k="j.0" /></p><h2 id="appearance-title"><T locale={locale} k="j.1" /></h2></div><button id="appearance-close" class="icon-button" type="button" aria-label={t[11]} data-i18n-aria-label="j.11"><X size={20} aria-hidden="true" /></button></div>
  <div class="field"><label for="theme-choice"><T locale={locale} k="j.2" /></label><select id="theme-choice"><option value="dark" data-i18n="j.3">{t[3]}</option><option value="light" data-i18n="j.4">{t[4]}</option></select></div>
  <fieldset class="accent-options"><legend><T locale={locale} k="j.5" /></legend><label class="radio-option"><input type="radio" name="accent-mode" value="system" checked /><T locale={locale} k="j.6" /></label><p class="setting-help"><T locale={locale} k="j.7" /></p><label class="radio-option"><input type="radio" name="accent-mode" value="custom" /><T locale={locale} k="j.8" /></label><div class="custom-accent"><label for="accent-picker"><T locale={locale} k="j.9" /></label><input id="accent-picker" type="color" value="#c8a96b" /><output id="accent-value" for="accent-picker">#C8A96B</output></div></fieldset>
  <button id="accent-reset" type="button"><T locale={locale} k="j.10" /></button><p class="setting-help" id="appearance-feedback" role="status"><T locale={locale} k="j.12" /></p>
</dialog>
<script>import '../../scripts/appearance';</script>
