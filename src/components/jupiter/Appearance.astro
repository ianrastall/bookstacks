---
import T from '../InterfaceText.astro';
import { Settings2, X } from '@lucide/astro';
import '../../i18n/catalogues';
import { text } from '../../lib/interface';
import type { Locale } from '../../lib/i18n';
interface Props { locale:Locale; }
const {locale}=Astro.props;
const t=(key:string)=>text(locale,key);
---
<button id="appearance-open" disabled type="button" class="appearance-trigger" aria-haspopup="dialog"><Settings2 size={17} aria-hidden="true" /><span><T locale={locale} k="settings" /></span></button>
<dialog id="appearance-dialog" aria-labelledby="appearance-title">
  <div class="dialog-heading"><div><p class="eyebrow"><T locale={locale} k="settings" /></p><h2 id="appearance-title"><T locale={locale} k="appearance" /></h2></div><button id="appearance-close" class="icon-button" type="button" aria-label={t('closeSettings')} data-i18n-aria-label="closeSettings"><X size={20} aria-hidden="true" /></button></div>
  <div class="field"><label for="theme-choice"><T locale={locale} k="theme" /></label><select id="theme-choice"><option value="dark" data-i18n="themeDark">{t('themeDark')}</option><option value="light" data-i18n="themeLight">{t('themeLight')}</option></select></div>
  <fieldset class="accent-options"><legend><T locale={locale} k="accentColor" /></legend><label class="radio-option"><input type="radio" name="accent-mode" value="system" checked /><T locale={locale} k="useSystemAccent" /></label><p class="setting-help"><T locale={locale} k="systemAccentHelp" /></p><label class="radio-option"><input type="radio" name="accent-mode" value="custom" /><T locale={locale} k="customColor" /></label><div class="custom-accent"><label for="accent-picker"><T locale={locale} k="chooseColor" /></label><input id="accent-picker" type="color" value="#c8a96b" /><output id="accent-value" for="accent-picker">#C8A96B</output></div></fieldset>
  <button id="accent-reset" type="button"><T locale={locale} k="resetAccent" /></button><p class="setting-help" id="appearance-feedback" role="status"><T locale={locale} k="settingsSaved" /></p>
</dialog>
<script>import '../../scripts/appearance';</script>
