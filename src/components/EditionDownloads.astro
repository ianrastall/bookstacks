---
import {
  editionDownloadHref,
  localizedWorkHref,
  type Author,
  type Edition,
  type Work,
} from '../lib/library';
import { languageData, ui, type Locale } from '../lib/i18n';

interface Props {
  author: Author;
  work: Work;
  edition: Edition;
  locale: Locale;
  compact?: boolean;
}

const { author, work, edition, locale, compact = false } = Astro.props;
const labels = ui(locale);
const stem = edition.sourceFile.replace(/\.xml$/i, '');
const file = (suffix: Parameters<typeof editionDownloadHref>[2]) => editionDownloadHref(author, edition, suffix);
const groups = [
  {
    label: labels.read,
    formats: [
      { name: 'EPUB', suffix: 'epub' as const, icon: 'auto_stories' },
      { name: 'PDF', suffix: 'pdf' as const, icon: 'picture_as_pdf' },
      { name: 'HTML', suffix: 'html.zip' as const, icon: 'language' },
    ],
  },
  {
    label: labels.editAndReuse,
    formats: [
      { name: 'Markdown', suffix: 'md' as const, icon: 'markdown' },
      { name: 'DOCX', suffix: 'docx' as const, icon: 'description' },
      { name: 'LaTeX', suffix: 'latex.zip' as const, icon: 'functions' },
    ],
  },
  {
    label: labels.source,
    formats: [{ name: 'TEI XML', href: `/tei/${author.slug}/${edition.sourceFile}`, icon: 'code' }],
  },
  {
    label: labels.data,
    formats: [
      { name: 'JSONL', suffix: 'jsonl' as const, icon: 'data_object' },
      { name: 'Manifest', suffix: 'manifest.json' as const, icon: 'fact_check' },
    ],
  },
];
---

<article id={compact ? undefined : 'downloads'} class:list={['download-edition', { 'download-edition-compact': compact }]}>
  <a class="download-cover-link" href={file('cover.png')} aria-label={`${labels.download}: ${edition.sourceTitle}`}>
    <span class="download-cover-placeholder" aria-hidden="true"><span>{edition.sourceTitle}</span><small>{author.name}</small></span>
    <img class="download-cover" src={file('cover.png')} alt="" width="320" height="512" loading="lazy" onerror="this.style.display='none'" />
  </a>
  <div class="download-edition-body">
    <header class="download-edition-header">
      {compact ? <h2><a href={localizedWorkHref(work, locale)}>{edition.sourceTitle}</a></h2> : <h3>{labels.downloadEdition}</h3>}
      {compact && <p>{author.name} · {languageData(locale).nativeName}</p>}
    </header>
    <div class="download-groups">
      {groups.map((group) => (
        <section class="download-group" aria-label={group.label}>
          <p class="download-group-label">{group.label}</p>
          <div class="download-links">
            {group.formats.map((format) => (
              <a
                class="btn btn-secondary btn-compact"
                href={'href' in format ? format.href : file(format.suffix)}
                download
                title={`${labels.download} ${format.name}`}
              >
                <span class="material-icons" aria-hidden="true">{format.icon}</span>{format.name}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div class="kindle-handoff">
      <div>
        <strong>{labels.sendToKindle}</strong>
        <p>{labels.sendToKindleHelp}</p>
      </div>
      <div class="download-links">
        <a class="btn btn-secondary btn-compact" href={file('epub')} download={`${stem}.epub`}>
          <span class="material-icons" aria-hidden="true">download</span>{labels.downloadEpub}
        </a>
        <a class="btn btn-primary btn-compact" href="https://www.amazon.com/sendtokindle" rel="noreferrer" target="_blank">
          <span class="material-icons" aria-hidden="true">send</span>{labels.sendToKindle}
        </a>
      </div>
    </div>
  </div>
</article>
