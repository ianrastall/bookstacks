---
import {
  editionPdfHref,
  editionTeiHref,
  localizedWorkHref,
  type Author,
  type Edition,
  type Work,
} from '../lib/library';
import { languageData, ui, type Locale } from '../lib/i18n';

interface Props {
  author: Author;
  work: Work;
  edition: Edition;
  locale: Locale;
  compact?: boolean;
}

const { author, work, edition, locale, compact = false } = Astro.props;
const labels = ui(locale);
const pdfHref = editionPdfHref(author, edition);
---

<article id={compact ? undefined : 'downloads'} class:list={['download-edition', 'download-edition-repository', { 'download-edition-compact': compact }]}>
  <div class="download-edition-body">
    <header class="download-edition-header">
      {compact ? <h2><a href={localizedWorkHref(work, locale)}>{edition.sourceTitle}</a></h2> : <h3>{labels.downloadEdition}</h3>}
      {compact && <p>{author.name} · {languageData(locale).nativeName}</p>}
    </header>
    <div class="download-links repository-download-links">
      <a class:list={['btn', 'btn-compact', pdfHref ? 'btn-secondary' : 'btn-primary']} href={editionTeiHref(author, edition)} download={edition.sourceFile}>
        <span class="material-icons" aria-hidden="true">code</span>TEI XML
      </a>
      {pdfHref && (
        <a class="btn btn-primary btn-compact" href={pdfHref} download={edition.pdfFile}>
          <span class="material-icons" aria-hidden="true">picture_as_pdf</span>PDF
        </a>
      )}
    </div>
  </div>
</article>
