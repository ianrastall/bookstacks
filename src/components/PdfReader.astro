---
import T from './InterfaceText.astro';
import {editionPdfHref,isEmbeddablePdfHref,type Author,type Edition} from '../lib/library';
import type {Locale} from '../lib/i18n';
import {text} from '../lib/interface';
interface Props {author:Author;edition:Edition;locale:Locale;unitTitle:string;unitContext:string[]}
const {author,edition,locale,unitTitle,unitContext}=Astro.props;
const legacy=editionPdfHref(author,edition);
const variants=edition.pdfVariants?.filter(pdf=>isEmbeddablePdfHref(pdf.href))??[];
const files=variants.length?variants:legacy&&isEmbeddablePdfHref(legacy)?[{theme:'dark',href:legacy,revision:legacy}]:[];
---
{files.length>0&&<section id="pdf-reader" class="pdf-reading-content" data-pdf-pane data-pdf-files={JSON.stringify(files)} data-pdf-title={unitTitle} data-pdf-context={JSON.stringify(unitContext)} lang={edition.code} translate="no" hidden>
  <div class="pdf-page-controls" lang={locale} translate="yes">
    <button type="button" data-pdf-previous disabled><T locale={locale} k="previous" /></button>
    <label><T locale={locale} k="pdfPage" /><input data-pdf-page type="number" min="1" value="1" step="1" inputmode="numeric" aria-label={text(locale,'pdfPage')} data-i18n-aria-label="pdfPage" /><output data-pdf-count> / —</output></label>
    <button type="button" data-pdf-next disabled><T locale={locale} k="next" /></button>
  </div>
  <div class="pdf-document-tools" lang={locale} translate="yes">
    <label class="pdf-outline-label"><T locale={locale} k="contents" /><select data-pdf-outline disabled><option>—</option></select></label>
    <a data-pdf-download href={files[0].href} download><T locale={locale} k="downloads" /> · PDF</a>
    <form data-pdf-find-form><label><T locale={locale} k="pdfFind" /><input type="search" data-pdf-find /></label><button type="submit"><T locale={locale} k="next" /></button></form>
  </div>
  <progress data-pdf-loading aria-label={text(locale,'readPdf')} data-i18n-aria-label="readPdf"></progress>
  <p data-pdf-error role="status" hidden lang={locale}><T locale={locale} k="pdfError" /></p>
  <p data-pdf-no-match role="status" hidden lang={locale}><T locale={locale} k="pdfNoMatches" /></p>
  <div class="pdf-page-host" data-pdf-page-host></div>
</section>}
<script>import '../scripts/pdf-reader';</script>
<style>
  .pdf-reading-content{border:1px solid var(--border);border-radius:4px;background:var(--panel);min-width:0;overflow:hidden;}
  .pdf-page-controls,.pdf-document-tools{padding:12px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;font:14px var(--sans-font);border-bottom:1px solid var(--border);}
  label{display:flex;align-items:center;gap:6px;min-width:0;}
  input,select{min-width:0;max-width:100%;font:inherit;color:var(--text);background:var(--input);border:1px solid var(--control-border);border-radius:4px;padding:6px;}
  input[type=number]{width:5.5em;}.pdf-outline-label{flex:1;min-width:120px;}select{width:100%;}
  button{color:var(--text);background:var(--panel-muted);border:1px solid var(--control-border);padding:6px 10px;border-radius:4px;}
  form{display:flex;flex:1 1 100%;gap:8px;}form label{flex:1;}input[type=search]{width:100%;}
  progress{display:block;width:calc(100% - 24px);margin:12px;}p{padding:0 12px;}
  .pdf-page-host{position:relative;width:100%;min-height:3rem;}
  @media(max-width:380px){.pdf-page-controls label{order:-1;flex-basis:100%;justify-content:center;}}
</style>
