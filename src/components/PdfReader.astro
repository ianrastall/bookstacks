---
import T from './InterfaceText.astro';
import { editionPdfHref, isEmbeddablePdfHref, type Author, type Edition } from '../lib/library';
import type { Locale } from '../lib/i18n';
interface Props { author: Author; edition: Edition; locale: Locale }
const { author, edition, locale } = Astro.props;
const legacy = editionPdfHref(author, edition);
const localVariants = edition.pdfVariants?.filter(pdf => isEmbeddablePdfHref(pdf.href)) ?? [];
const files = localVariants.length ? localVariants : legacy && isEmbeddablePdfHref(legacy) ? [{ theme: 'dark', href: legacy, revision: legacy }] : [];
---
{files.length > 0 && <details id="pdf-reader" class="pdf-reader edition-panel" data-pdf-files={JSON.stringify(files)}>
  <summary><T locale={locale} k="readPdf" /></summary>
  <div class="pdf-reader-controls">
    {files.length > 1 && <label><T locale={locale} k="theme" /> <select data-pdf-theme aria-label="PDF" disabled>
      {files.map(pdf => <option value={pdf.theme}><T locale={locale} k={pdf.theme === 'light' ? 'themeLight' : 'themeDark'} /></option>)}
    </select></label>}
    <a data-pdf-download class="btn btn-secondary btn-compact" href={files[0].href} download><T locale={locale} k="downloads" /> · PDF</a>
  </div>
  <iframe title={`${edition.sourceTitle} · PDF`} data-pdf-frame data-pdf-language={edition.code} allow="fullscreen" class="pdf-frame" hidden></iframe>
  <noscript><p><a href={files[0].href}>PDF</a></p></noscript>
</details>}
<script>import '../scripts/pdf-reader';</script>
<style>
  .pdf-reader { margin-block:var(--space-6);padding:var(--space-4); }
  summary { cursor:pointer;font-weight:600; }
  .pdf-reader-controls { display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap;margin-block:var(--space-4); }
  label { display:flex;align-items:center;gap:var(--space-2); }
  select { background:var(--input);color:var(--text);border:1px solid var(--control-border);padding:6px;border-radius:4px; }
  .pdf-frame { display:block;width:100%;height:80dvh;min-height:400px;border:1px solid var(--border);background:var(--panel-muted); }
  @media(max-width:600px) { .pdf-reader { padding:var(--space-2); }.pdf-frame { height:80dvh; } }
</style>
