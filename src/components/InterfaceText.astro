---
import '../i18n/catalogues';
import { text, type TranslationArg } from '../lib/interface';
import type { Locale } from '../lib/i18n';
interface Props { k: string; locale: Locale; args?: TranslationArg[] }
const { k, locale, args = [] } = Astro.props;
---
<span data-i18n={k} data-i18n-args={args.length ? JSON.stringify(args) : undefined}>{text(locale, k, args)}</span>
