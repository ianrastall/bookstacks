---
import '../styles/global.css';
import '../styles/jupiter.css';
import 'material-icons/iconfont/filled.css';
import { ArrowUpRight,BookOpen,Download } from '@lucide/astro';
import Appearance from '../components/jupiter/Appearance.astro';
import { SUPPORTED_LANGUAGES,ui,type Locale } from '../lib/i18n';
import { jupiterUi } from '../lib/jupiter-ui';
interface Props { title:string;description?:string;wide?:boolean;locale?:Locale;languageLinks?:Partial<Record<Locale,string>>; }
const {title,locale='en',languageLinks={},description=ui(locale).siteDescription,wide=false}=Astro.props;
const labels=ui(locale),t=jupiterUi(locale);
const pageTitle=title==='Bookstacks' ? title : `${title} · Bookstacks`;
const routePath=Astro.url.pathname.replace(/\.html$/,'');
const canonicalPath=routePath==='/' ? '/' : routePath.replace(/\/+$/,'');
---
<!doctype html>
<html lang={locale} data-theme="dark" data-reader-page={wide ? 'true' : undefined}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CSSQ9K2FFC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CSSQ9K2FFC');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    {SUPPORTED_LANGUAGES.map((language) => (
      <link rel="alternate" hreflang={language.code} href={new URL(languageLinks[language.code] ?? `/${language.code}`, Astro.site)} />
    ))}
    <slot name="head" />
    <script is:inline>
      try {
        const root=document.documentElement;
        root.dataset.theme=localStorage.getItem('bookstacks-theme') === 'light' ? 'light' : 'dark';
        const old=localStorage.getItem('bookstacks-palette');
        const palettes={blue:'#3f6178',green:'#527052',red:'#8d4b46',orange:'#93672e',indigo:'#5c577f',brown:'#765b43',coral:'#9c514b'};
        let accent=localStorage.getItem('bookstacks-accent');
        if(!accent && old && palettes[old]){accent=palettes[old];localStorage.setItem('bookstacks-accent',accent);}
        if(accent && /^#[0-9a-f]{6}$/i.test(accent))root.style.setProperty('--accent',accent);
        const serif=localStorage.getItem('bookstacks-reader-serif');const sans=localStorage.getItem('bookstacks-reader-sans');
        if(['classic','charter','old-style','garamond','platform','times'].includes(serif))root.dataset.readerSerif=serif;
        if(['office','system','helvetica','humanist','screen','trebuchet'].includes(sans))root.dataset.readerSans=sans;
      } catch { /* Browser storage is optional. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{labels.skipToContent}</a>
    <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><BookOpen size={21} /></span><span>Bookstacks<small>A Jupiter project</small></span></a>
      <nav class="site-network" aria-label={labels.siteNetwork}><a href="https://text-utils.net">Text Utilities <ArrowUpRight size={13} aria-hidden="true" /></a><a href="https://chessnerd.net">Chess Nerd <ArrowUpRight size={13} aria-hidden="true" /></a><a href="/" class="network-current" aria-current="true">Bookstacks</a></nav>
      <Appearance locale={locale} />
    </header>
    <div class="library-nav shell"><nav aria-label={labels.library}><a href="/"><BookOpen size={15} aria-hidden="true" />{labels.allLanguages}</a><a href={`/${locale}`}>{labels.library}</a><a href={`/${locale}/downloads`}><Download size={15} aria-hidden="true" />{labels.downloads}</a></nav><nav class="language-switcher" aria-label={labels.chooseLanguage}>{SUPPORTED_LANGUAGES.map(language=><a class="language-option" href={languageLinks[language.code] ?? `/${language.code}`} aria-current={canonicalPath!=='/'&&language.code===locale?'page':undefined} lang={language.code} hreflang={language.code} title={language.nativeName}><span aria-hidden="true">{language.flag}</span><span>{language.nativeName}</span></a>)}</nav></div>
    <main id="content"><slot /></main>
    <footer class="site-footer shell"><strong>Bookstacks</strong><nav aria-label={labels.siteNetwork}><a href="https://github.com/ianrastall/bookstacks">{t[17]} ↗</a><a href="https://ko-fi.com/ianrastall">{t[15]} ↗</a></nav></footer>
  </body>
</html>
