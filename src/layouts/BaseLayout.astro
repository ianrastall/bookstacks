---
import T from '../components/InterfaceText.astro';
import '../styles/global.css';
import '../styles/jupiter.css';
import 'material-icons/iconfont/filled.css';
import { ArrowUpRight,BookOpen,Download } from '@lucide/astro';
import '../i18n/catalogues';
import { text } from '../lib/interface';
import Appearance from '../components/jupiter/Appearance.astro';
import { INTERFACE_LOCALES,localeDirection,type Locale } from '../lib/i18n';
interface Props { title:string;description?:string;wide?:boolean;locale?:Locale;titleKey?:string; }
const {title,titleKey,locale='en',description=text(locale,'siteDescription'),wide=false}=Astro.props;
const t=(key:string)=>text(locale,key);
const pageTitle=title==='Bookstacks' ? title : `${title} · Bookstacks`;
const routePath=Astro.url.pathname.replace(/\.html$/,'');
const canonicalPath=routePath==='/' ? '/' : routePath.replace(/\/+$/,'');
---
<!doctype html>
<html lang={locale} dir={localeDirection(locale)} data-title-key={titleKey} data-theme="dark" data-reader-page={wide ? 'true' : undefined}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CSSQ9K2FFC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CSSQ9K2FFC');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const root=document.documentElement;
        root.dataset.theme=localStorage.getItem('bookstacks-theme') === 'light' ? 'light' : 'dark';
        const old=localStorage.getItem('bookstacks-palette');
        const palettes={blue:'#3f6178',green:'#527052',red:'#8d4b46',orange:'#93672e',indigo:'#5c577f',brown:'#765b43',coral:'#9c514b'};
        let accent=localStorage.getItem('bookstacks-accent');
        if(!accent && old && palettes[old]){accent=palettes[old];localStorage.setItem('bookstacks-accent',accent);}
        if(accent && /^#[0-9a-f]{6}$/i.test(accent))root.style.setProperty('--accent',accent);
      } catch { /* Browser storage is optional. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content"><T locale={locale} k="skipToContent" /></a>
    <header class="site-header">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><BookOpen size={21} /></span><span>Bookstacks<small lang="en">A Jupiter project</small></span></a>
      <nav class="site-network" aria-label={t('siteNetwork')} data-i18n-aria-label="siteNetwork"><a href="https://text-utils.net">Text Utilities <ArrowUpRight size={13} aria-hidden="true" /></a><a href="https://chessnerd.net">Chess Nerd <ArrowUpRight size={13} aria-hidden="true" /></a><a href="/" class="network-current" aria-current="true">Bookstacks</a></nav>
      <Appearance locale={locale} />
    </header>
    <div class="library-nav shell">
      <nav aria-label={t('library')} data-i18n-aria-label="library">
        <a href="/"><BookOpen size={15} aria-hidden="true" /><T locale={locale} k="library" /></a>
        <a href="/authors"><T locale={locale} k="authors" /></a>
        <a href="/downloads"><Download size={15} aria-hidden="true" /><T locale={locale} k="downloads" /></a>
      </nav>
      <div class="interface-choice field">
        <label for="interface-language"><T locale={locale} k="interfaceLanguage" /></label>
        <select id="interface-language" disabled>
          <option value="auto" data-i18n="automaticLanguage">{t('automaticLanguage')}</option>
          {INTERFACE_LOCALES.map(language=><option value={language.code} lang={language.code} dir={language.dir}>{language.nativeName}</option>)}
        </select>
      </div>
      <span id="interface-feedback" class="visually-hidden" role="status"></span>
      <noscript><nav class="noscript-languages" aria-label={t('chooseLanguage')}>{INTERFACE_LOCALES.map(language=><a href={`/${language.code}`} lang={language.code} dir={language.dir} hreflang={language.code}>{language.nativeName}</a>)}</nav></noscript>
    </div>
    <main id="content"><slot /></main>
    <footer class="site-footer shell"><strong>Bookstacks</strong><nav aria-label={t('siteNetwork')} data-i18n-aria-label="siteNetwork"><a href="https://github.com/ianrastall/bookstacks"><T locale={locale} k="sourceOnGitHub" /> ↗</a><a href="https://ko-fi.com/ianrastall"><T locale={locale} k="support" /> ↗</a></nav></footer>
    <script>import '../scripts/interface';</script>
  </body>
</html>
