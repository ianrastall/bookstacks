---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'A curated library of public domain literature.' } = Astro.props;
const pageTitle = title === 'Bookstacks' ? title : `${title} - Bookstacks`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CSSQ9K2FFC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CSSQ9K2FFC');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('bookstacks-theme');
        const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">
          <span class="brand-mark"><span class="material-icons">library_books</span></span>
          <span>Bookstacks</span>
        </a>
        <nav class="site-network" aria-label="Site network">
          <a href="https://github.com/ianrastall/bookstacks" rel="noreferrer" target="_blank">GitHub</a>
          <a href="https://text-utils.net" rel="noreferrer" target="_blank">Text Utilities</a>
          <a href="https://chessnerd.net" rel="noreferrer" target="_blank">Chess Nerd</a>
        </nav>
        <div class="header-actions">
          <label class="color-picker-wrap" title="Accent color">
            <span class="visually-hidden">Accent color</span>
            <span class="color-swatch" id="color-swatch"></span>
            <input type="color" id="accent-picker" aria-label="Accent color" />
          </label>
          <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle theme">
            <span class="material-icons" aria-hidden="true">dark_mode</span>
          </button>
        </div>
      </header>
    </div>
    <main id="content"><slot /></main>
    <div class="shell">
      <footer class="site-footer">
        <p>A curated library of public domain literature. Bookstacks runs locally in your browser (some tools may make external requests).</p>
        <p class="support-blurb">If this saved you a few hours of work, or is something you would have paid $5 for, consider <a href="https://ko-fi.com/ianrastall" rel="noreferrer" target="_blank">buying me a coffee on Ko-fi</a>.</p>
      </footer>
    </div>
    <script>
      const themeToggle = document.getElementById('theme-toggle');

      function hexToHsl(hex: string): [number, number, number] {
        const r = parseInt(hex.slice(1, 3), 16) / 255;
        const g = parseInt(hex.slice(3, 5), 16) / 255;
        const b = parseInt(hex.slice(5, 7), 16) / 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h = 0, s = 0;
        const l = (max + min) / 2;
        if (max !== min) {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
          if (max === g) h = ((b - r) / d + 2) / 6;
          if (max === b) h = ((r - g) / d + 4) / 6;
        }
        return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
      }

      function hslToHex(h: number, s: number, l: number): string {
        s /= 100; l /= 100;
        const k = (n: number) => (n + h / 30) % 12;
        const a = s * Math.min(l, 1 - l);
        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
        return '#' + [f(0), f(8), f(4)].map((value) => Math.round(value * 255).toString(16).padStart(2, '0')).join('');
      }

      function applyAccent(hex: string | null) {
        const root = document.documentElement;
        if (!hex) {
          root.style.removeProperty('--accent');
          root.style.removeProperty('--accent-strong');
          return;
        }
        const [h, s] = hexToHsl(hex);
        const isDark = root.dataset.theme === 'dark';
        root.style.setProperty('--accent', isDark ? hslToHex(h, Math.min(s + 10, 100), 65) : hslToHex(h, Math.min(s, 90), 40));
        root.style.setProperty('--accent-strong', isDark ? hslToHex(h, Math.min(s + 5, 100), 75) : hslToHex(h, Math.min(s, 90), 32));
      }

      function updateControls() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const icon = themeToggle?.querySelector('.material-icons');
        if (icon) icon.textContent = isDark ? 'dark_mode' : 'light_mode';
        themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        const stored = localStorage.getItem('bookstacks-accent');
        applyAccent(stored);
        const swatch = document.getElementById('color-swatch') as HTMLElement | null;
        if (swatch && stored) swatch.style.background = stored;
      }

      const storedAccent = localStorage.getItem('bookstacks-accent');
      const picker = document.getElementById('accent-picker') as HTMLInputElement | null;
      if (storedAccent && picker) picker.value = storedAccent;
      updateControls();

      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('bookstacks-theme', next);
        updateControls();
      });

      picker?.addEventListener('input', () => {
        localStorage.setItem('bookstacks-accent', picker.value);
        applyAccent(picker.value);
        const swatch = document.getElementById('color-swatch') as HTMLElement | null;
        if (swatch) swatch.style.background = picker.value;
      });

      picker?.addEventListener('dblclick', () => {
        localStorage.removeItem('bookstacks-accent');
        applyAccent(null);
        const swatch = document.getElementById('color-swatch') as HTMLElement | null;
        if (swatch) swatch.style.background = '';
      });
    </script>
  </body>
</html>
