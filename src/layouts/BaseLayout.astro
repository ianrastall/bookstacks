---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'Complete public-domain books prepared as TEI and presented for close reading.',
  wide = false,
} = Astro.props;
const pageTitle = title === 'Bookstacks' ? title : `${title} · Bookstacks`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe7" />
    <title>{pageTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CSSQ9K2FFC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CSSQ9K2FFC');
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2212%22 fill=%22%232d5548%22/><path d=%22M15 14h14c4 0 7 3 7 7v29c-2-3-5-4-9-4H15zm34 0H35c-4 0-7 3-7 7v29c2-3 5-4 9-4h12z%22 fill=%22%23f7f0d9%22/></svg>" />
    <slot name="head" />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('bookstacks-theme');
        const savedAccent = localStorage.getItem('bookstacks-accent');
        const dark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = savedTheme || (dark ? 'dark' : 'light');
        if (savedAccent) document.documentElement.style.setProperty('--accent', savedAccent);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Bookstacks home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Bookstacks</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/">Library</a>
          <a href="https://github.com/ianrastall/bookstacks" rel="noreferrer" target="_blank">Source</a>
        </nav>
        <div class="display-controls">
          <label class="accent-control" title="Choose accent color">
            <span class="visually-hidden">Accent color</span>
            <input id="accent-picker" type="color" value="#2d6a58" aria-label="Accent color" />
          </label>
          <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch color theme" title="Switch color theme">◐</button>
        </div>
      </div>
    </header>
    <main id="content" class:list={['shell', { 'shell-wide': wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Complete books, encoded in TEI and built as a static library.</p>
        <p><a href="https://ko-fi.com/ianrastall" rel="noreferrer" target="_blank">Support Bookstacks</a></p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const accentPicker = document.querySelector<HTMLInputElement>('#accent-picker');
      const savedAccent = localStorage.getItem('bookstacks-accent');
      if (savedAccent && accentPicker) accentPicker.value = savedAccent;

      themeButton?.addEventListener('click', () => {
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        localStorage.setItem('bookstacks-theme', theme);
      });
      accentPicker?.addEventListener('input', () => {
        root.style.setProperty('--accent', accentPicker.value);
        localStorage.setItem('bookstacks-accent', accentPicker.value);
      });
      accentPicker?.addEventListener('dblclick', () => {
        root.style.removeProperty('--accent');
        localStorage.removeItem('bookstacks-accent');
        accentPicker.value = '#2d6a58';
      });
    </script>
  </body>
</html>
