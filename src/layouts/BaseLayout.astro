---
import '../styles/global.css';
import { SUPPORTED_LANGUAGES, ui, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  locale?: Locale;
  languageLinks?: Partial<Record<Locale, string>>;
}

const {
  title,
  locale = 'en',
  languageLinks = {},
  description = ui(locale).siteDescription,
} = Astro.props;
const labels = ui(locale);
const pageTitle = title === 'Bookstacks' ? title : `${title} - Bookstacks`;
const palettes = [
  { id: 'blue', label: labels.colors.blue, swatch: '#b9c9d6' },
  { id: 'green', label: labels.colors.green, swatch: '#becab7' },
  { id: 'red', label: labels.colors.red, swatch: '#d9b1ac' },
  { id: 'orange', label: labels.colors.orange, swatch: '#dbc29e' },
  { id: 'indigo', label: labels.colors.indigo, swatch: '#bdbbd1' },
  { id: 'brown', label: labels.colors.brown, swatch: '#cbb9a5' },
  { id: 'coral', label: labels.colors.coral, swatch: '#f4b3ad' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CSSQ9K2FFC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CSSQ9K2FFC');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {SUPPORTED_LANGUAGES.map((language) => (
      <link rel="alternate" hreflang={language.code} href={new URL(languageLinks[language.code] ?? `/${language.code}`, Astro.site)} />
    ))}
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('bookstacks-theme');
        const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored || (prefersDark ? 'dark' : 'light');
        const palette = localStorage.getItem('bookstacks-palette');
        const allowed = ['blue', 'green', 'red', 'orange', 'indigo', 'brown', 'coral'];
        document.documentElement.dataset.palette = palette && allowed.includes(palette) ? palette : 'coral';
        const serif = localStorage.getItem('bookstacks-reader-serif');
        const serifFonts = ['classic', 'charter', 'old-style', 'garamond', 'platform', 'times'];
        document.documentElement.dataset.readerSerif = serif && serifFonts.includes(serif) ? serif : 'classic';
        const sans = localStorage.getItem('bookstacks-reader-sans');
        const sansFonts = ['office', 'system', 'helvetica', 'humanist', 'screen', 'trebuchet'];
        document.documentElement.dataset.readerSans = sans && sansFonts.includes(sans) ? sans : 'office';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{labels.skipToContent}</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={`/${locale}`}>
          <span class="brand-mark"><span class="material-icons">library_books</span></span>
          <span>Bookstacks</span>
        </a>
        <nav class="site-network" aria-label={labels.siteNetwork}>
          <a href={`/${locale}/downloads`}><span class="material-icons" aria-hidden="true">download</span>{labels.downloads}</a>
          <a href="https://github.com/ianrastall/bookstacks" rel="noreferrer" target="_blank">GitHub</a>
          <a href="https://text-utils.net" rel="noreferrer" target="_blank">Text Utilities</a>
          <a href="https://chessnerd.net" rel="noreferrer" target="_blank">Chess Nerd</a>
        </nav>
        <div class="header-actions">
          <nav class="language-switcher" aria-label={labels.chooseLanguage}>
            {SUPPORTED_LANGUAGES.map((language) => (
              <a
                class="language-option"
                href={languageLinks[language.code] ?? `/${language.code}`}
                aria-current={language.code === locale ? 'page' : undefined}
                lang={language.code}
                hreflang={language.code}
                title={language.nativeName}
              >
                <span class="language-flag" aria-hidden="true">{language.flag}</span>
                <span class="visually-hidden">{language.nativeName}</span>
              </a>
            ))}
          </nav>
          <details class="palette-picker" id="palette-picker">
            <summary aria-label={labels.chooseColorTheme} title={labels.chooseColorTheme}>
              <span class="palette-current-swatch" aria-hidden="true"></span>
            </summary>
            <div class="palette-menu" role="group" aria-label={labels.colorThemes}>
              {palettes.map((palette) => (
                <button class="palette-option" type="button" data-palette={palette.id} aria-pressed="false">
                  <span class="palette-option-swatch" style={`--palette-swatch: ${palette.swatch}`} aria-hidden="true"></span>
                  <span>{palette.label}</span>
                  <span class="material-icons palette-check" aria-hidden="true">check</span>
                </button>
              ))}
            </div>
          </details>
          <button id="theme-toggle" class="icon-button" type="button" aria-label={labels.toggleTheme} data-light-label={labels.switchToLight} data-dark-label={labels.switchToDark}>
            <span class="material-icons" aria-hidden="true">dark_mode</span>
          </button>
        </div>
      </header>
    </div>
    <main id="content"><slot /></main>
    <div class="shell">
      <footer class="site-footer">
        <p>{labels.curatedLibrary}</p>
        <p class="support-blurb"><a href="https://ko-fi.com/ianrastall" rel="noreferrer" target="_blank">{labels.support}</a></p>
      </footer>
    </div>
    <script>
      const themeToggle = document.getElementById('theme-toggle');
      const palettePicker = document.getElementById('palette-picker') as HTMLDetailsElement | null;
      const paletteButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.palette-option'));

      function updateControls() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const icon = themeToggle?.querySelector('.material-icons');
        if (icon) icon.textContent = isDark ? 'dark_mode' : 'light_mode';
        themeToggle?.setAttribute('aria-label', isDark ? themeToggle.dataset.lightLabel || '' : themeToggle.dataset.darkLabel || '');
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        const selected = document.documentElement.dataset.palette || 'coral';
        for (const button of paletteButtons) {
          button.setAttribute('aria-pressed', String(button.dataset.palette === selected));
        }
      }

      updateControls();

      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('bookstacks-theme', next);
        updateControls();
      });

      for (const button of paletteButtons) {
        button.addEventListener('click', () => {
          const palette = button.dataset.palette;
          if (!palette) return;
          document.documentElement.dataset.palette = palette;
          localStorage.setItem('bookstacks-palette', palette);
          updateControls();
          if (palettePicker) palettePicker.open = false;
        });
      }
    </script>
  </body>
</html>
