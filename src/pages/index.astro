---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorHref, getLibrary } from '../lib/library';

const library = getLibrary();
const format = new Intl.NumberFormat('en-US');
const libraryDescription = `A curated index of public domain texts, with ${library.authors.length} authors, ${library.workCount} books, ${library.editionCount} TEI editions, and ${format.format(library.unitCount)} reading units.`;
---

<BaseLayout title="Home">
  <section class="tool-container shell" style="margin-top: 2rem;">
    <h1 class="visually-hidden">Library</h1>
    <div class="tool-header">
      <div class="tool-title">
        <span class="material-icons" aria-hidden="true">library_books</span>
        <h2>Library</h2>
      </div>
    </div>
    <p class="tool-description">{libraryDescription}</p>
    <div class="tool-grid author-grid">
      {library.authors.map((author) => {
        const editionCount = author.works.reduce((sum, work) => sum + work.editions.length, 0);
        return (
          <a class="tool-card author-card" href={authorHref(author)}>
            <div class="author-card-media">
              <img src={`/img/authors/${author.portrait}`} alt={`Portrait of ${author.name}`} class="author-portrait" width="500" height="500" loading="lazy" />
            </div>
            <div class="author-card-body">
              <h3 class="author-name">{author.name}</h3>
              <p class="author-dates">{author.dates}</p>
              <p class="author-book-count">
                {author.works.length} {author.works.length === 1 ? 'book' : 'books'} · {editionCount} {editionCount === 1 ? 'edition' : 'editions'}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
