---
import BaseLayout from '../layouts/BaseLayout.astro';
import { authorHref, getLibrary } from '../lib/library';

const library = getLibrary();
const format = new Intl.NumberFormat('en-US');
---

<BaseLayout title="Bookstacks">
  <section class="hero">
    <p class="eyebrow">A library in the text</p>
    <h1>Complete books,<br /><em>carefully structured.</em></h1>
    <p class="hero-copy">
      Read public-domain works prepared as standalone TEI editions—preserving their chapters,
      scholarly divisions, named people, places, notes, and original languages.
    </p>
    <dl class="library-stats" aria-label="Library statistics">
      <div><dt>{library.authors.length}</dt><dd>authors</dd></div>
      <div><dt>{library.workCount}</dt><dd>works</dd></div>
      <div><dt>{library.editionCount}</dt><dd>editions</dd></div>
      <div><dt>{format.format(library.unitCount)}</dt><dd>reading units</dd></div>
    </dl>
  </section>

  <section class="library-section" aria-labelledby="authors-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse the collection</p>
        <h2 id="authors-heading">Authors</h2>
      </div>
      <p>Every card opens a shelf of complete works and language editions.</p>
    </div>
    <div class="author-grid">
      {library.authors.map((author) => {
        const editions = author.works.reduce((sum, work) => sum + work.editions.length, 0);
        return (
          <a class="author-card" href={authorHref(author)}>
            <div class="portrait-frame">
              <img src={`/img/authors/${author.portrait}`} alt={`Engraved portrait of ${author.name}`} width="500" height="500" loading="lazy" />
            </div>
            <div class="author-card-copy">
              <p class="author-index">{String(library.authors.indexOf(author) + 1).padStart(2, '0')}</p>
              <h3>{author.name}</h3>
              <p class="author-dates">{author.dates}</p>
              <p class="card-meta">{author.works.length} {author.works.length === 1 ? 'work' : 'works'} · {editions} {editions === 1 ? 'edition' : 'editions'}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
