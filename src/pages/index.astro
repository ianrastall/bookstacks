---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allEntries = await getCollection('authors');
const authors = allEntries.filter(e => e.data.layout === 'author_index').sort((a, b) => a.id.localeCompare(b.id));
const books = allEntries.filter(e => e.data.layout === 'book_index');
const chapters = allEntries.filter(e => e.data.layout === 'book');

// Helper to construct relative URL
function relativeUrl(path: string) {
  return import.meta.env.BASE_URL + path.replace(/^\//, '');
}

// An author has a portrait if public/img/authors/<slug>.png exists.
function authorPortrait(slug: string) {
  const rel = `img/authors/${slug}.png`;
  return fs.existsSync(`public/${rel}`) ? relativeUrl(rel) : null;
}
---

<BaseLayout title="Home">
  <main class="shell">
    <h1 class="visually-hidden">Library</h1>
    <section class="tool-container" style="margin-top: 2rem;">
      <div class="tool-header">
        <div class="tool-title">
          <span class="material-icons">library_books</span>
          <h2>Library</h2>
        </div>
      </div>
      
      <p class="tool-description">A curated index of public domain texts, with {authors.length} authors, {books.length} books, and {chapters.length} chapters.</p>
      
      <div class="tool-grid author-grid">
        {authors.map(author => {
          let slug = author.id;
          if (slug.endsWith('/index')) slug = slug.slice(0, -6);
          const portrait = authorPortrait(slug);
          return (
            <a class="tool-card author-card" href={relativeUrl(`authors/${slug}`)}>
              <div class="author-card-media">
                {portrait ? (
                  <img
                    src={portrait}
                    alt={`Portrait of ${author.data.author_name}`}
                    class="author-portrait"
                    width="500"
                    height="500"
                    loading="lazy"
                  />
                ) : (
                  <span class="material-icons author-card-icon" aria-hidden="true">person</span>
                )}
              </div>
              <div class="author-card-body">
                <h3 class="author-name">{author.data.author_name}</h3>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
