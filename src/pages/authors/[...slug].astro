---
import TocTree from '../../components/TocTree.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  authorHref,
  getLibrary,
  unitHref,
  workHref,
  type Author,
  type Edition,
  type ReadingUnit,
  type Work,
} from '../../lib/library';

type Page =
  | { kind: 'author'; author: Author }
  | { kind: 'work'; author: Author; work: Work }
  | { kind: 'reader'; author: Author; work: Work; edition: Edition; unit: ReadingUnit };

interface Props {
  page: Page;
}

export function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: Props }> = [];
  for (const author of getLibrary().authors) {
    paths.push({ params: { slug: author.slug }, props: { page: { kind: 'author', author } } });
    for (const work of author.works) {
      paths.push({
        params: { slug: `${author.slug}/${work.slug}` },
        props: { page: { kind: 'work', author, work } },
      });
      for (const edition of work.editions) {
        for (const unit of edition.units) {
          paths.push({
            params: { slug: `${author.slug}/${work.slug}/${edition.code}/${unit.path}` },
            props: { page: { kind: 'reader', author, work, edition, unit } },
          });
        }
      }
    }
  }
  return paths;
}

const { page } = Astro.props;
const title = page.kind === 'author'
  ? page.author.name
  : page.kind === 'work'
    ? page.work.title
    : `${page.unit.title} · ${page.work.title}`;
const description = page.kind === 'author'
  ? `Complete TEI editions of works by ${page.author.name}.`
  : page.kind === 'work'
    ? `Read ${page.work.title} by ${page.author.name} in its available TEI editions.`
    : `${page.unit.title} from ${page.work.title} by ${page.author.name}.`;
---

<BaseLayout title={title} description={description} wide={page.kind === 'reader'}>
  {page.kind === 'author' && (
    <>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Library</a><span>/</span><span aria-current="page">{page.author.name}</span></nav>
      <header class="author-hero">
        <div class="author-hero-copy">
          <p class="eyebrow">Author shelf</p>
          <h1>{page.author.name}</h1>
          <p class="author-life">{page.author.dates}</p>
          <p>{page.author.works.length} complete {page.author.works.length === 1 ? 'work' : 'works'} in {page.author.works.reduce((sum, work) => sum + work.editions.length, 0)} prepared editions.</p>
        </div>
        <div class="author-hero-portrait portrait-frame">
          <img src={`/img/authors/${page.author.portrait}`} alt={`Engraved portrait of ${page.author.name}`} width="500" height="500" />
        </div>
      </header>
      <section class="works-section" aria-labelledby="works-heading">
        <div class="section-heading compact">
          <div><p class="eyebrow">On this shelf</p><h2 id="works-heading">Works</h2></div>
        </div>
        <div class="work-grid">
          {page.author.works.map((work, index) => (
            <a class="work-card" href={workHref(work)}>
              <p class="work-number">{String(index + 1).padStart(2, '0')}</p>
              <h3>{work.title}</h3>
              <div class="language-list" aria-label="Available languages">
                {work.editions.map((edition) => <span>{edition.languageName}</span>)}
              </div>
              <p class="card-meta">{work.editions.reduce((sum, edition) => sum + edition.units.length, 0)} reading units</p>
              <span class="card-action">Open work <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    </>
  )}

  {page.kind === 'work' && (
    <>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Library</a><span>/</span><a href={authorHref(page.author)}>{page.author.name}</a><span>/</span><span aria-current="page">{page.work.title}</span>
      </nav>
      <header class="work-hero">
        <p class="eyebrow">Complete work</p>
        <h1>{page.work.title}</h1>
        <p class="byline">by <a href={authorHref(page.author)}>{page.author.name}</a></p>
        <p class="work-intro">
          Each language below is a complete standalone TEI edition. Its own hierarchy is preserved;
          editions are not forced into artificial chapter-by-chapter alignment.
        </p>
        <nav class="edition-jump" aria-label="Available editions">
          {page.work.editions.map((edition) => <a href={`#edition-${edition.code}`}>{edition.languageName}</a>)}
        </nav>
      </header>
      <div class="edition-stack">
        {page.work.editions.map((edition) => (
          <article class="edition-panel" id={`edition-${edition.code}`}>
            <header class="edition-header">
              <div>
                <p class="eyebrow">{edition.kind === 'translation' ? 'Translation' : 'Edition'}</p>
                <h2>{edition.languageName}</h2>
                {edition.sourceTitle !== page.work.title && <p class="source-title" lang={edition.code}>{edition.sourceTitle}</p>}
              </div>
              <div class="edition-actions">
                {edition.units[0] && <a class="button" href={unitHref(page.work, edition, edition.units[0])}>Start reading</a>}
                <a class="text-link" href={`/tei/${page.author.slug}/${edition.sourceFile}`} download>Download TEI</a>
              </div>
            </header>
            <div class="edition-meta">
              <span>{edition.units.length} reading units</span>
              <span>Organized by {edition.unitKind.replaceAll('_', ' ')}</span>
              <span>{edition.sourceFile}</span>
            </div>
            <section class="toc-panel" aria-labelledby={`toc-${edition.code}`}>
              <h3 id={`toc-${edition.code}`}>Contents</h3>
              <TocTree nodes={edition.toc} />
            </section>
            {(edition.persons.length > 0 || edition.places.length > 0) && (
              <details class="registry-panel">
                <summary>TEI registries <span>{edition.persons.length} people · {edition.places.length} places</span></summary>
                <div class="registry-columns">
                  {edition.persons.length > 0 && (
                    <section><h3>People</h3><dl>{edition.persons.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>
                  )}
                  {edition.places.length > 0 && (
                    <section><h3>Places</h3><dl>{edition.places.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>
                  )}
                </div>
              </details>
            )}
          </article>
        ))}
      </div>
    </>
  )}

  {page.kind === 'reader' && (
    <>
      <nav class="breadcrumbs reader-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Library</a><span>/</span><a href={authorHref(page.author)}>{page.author.name}</a><span>/</span><a href={workHref(page.work)}>{page.work.title}</a><span>/</span><span aria-current="page">{page.edition.languageName}</span>
      </nav>
      <div class="reader-toolbar" aria-label="Reading controls">
        <div class="reader-edition">
          <span class="language-badge">{page.edition.languageName}</span>
          {page.work.editions.length > 1 && <a href={`${workHref(page.work)}#edition-${page.edition.code}`}>Other editions</a>}
        </div>
        <div class="reader-display">
          <button type="button" data-reader-action="narrow" aria-label="Narrow text column">−</button>
          <span>Width</span>
          <button type="button" data-reader-action="wide" aria-label="Widen text column">+</button>
          <button type="button" data-reader-action="smaller" aria-label="Decrease text size">A−</button>
          <button type="button" data-reader-action="larger" aria-label="Increase text size">A+</button>
        </div>
      </div>
      <article class="reader" lang={page.edition.code}>
        <header class="reader-header">
          {page.unit.context.length > 0 && <p class="reader-context">{page.unit.context.join(' · ')}</p>}
          <h1>{page.unit.title}</h1>
          <p><a href={workHref(page.work)}>{page.work.title}</a> · {page.author.name}</p>
        </header>
        <div class="reader-content" set:html={page.unit.html} />
      </article>
      <nav class="reader-pagination" aria-label="Reading order">
        {page.unit.previousPath ? (
          <a rel="prev" href={`${workHref(page.work)}/${page.edition.code}/${page.unit.previousPath}`}><span>← Previous</span><strong>Earlier in this edition</strong></a>
        ) : <span></span>}
        {page.unit.nextPath && (
          <a rel="next" class="next" href={`${workHref(page.work)}/${page.edition.code}/${page.unit.nextPath}`}><span>Next →</span><strong>Continue reading</strong></a>
        )}
      </nav>
      <script>
        const readerRoot = document.documentElement;
        let width = Number(localStorage.getItem('bookstacks-reader-width') || 44);
        let scale = Number(localStorage.getItem('bookstacks-reader-scale') || 1);
        const applyReaderSettings = () => {
          readerRoot.style.setProperty('--reader-width', `${width}rem`);
          readerRoot.style.setProperty('--reader-scale', String(scale));
        };
        applyReaderSettings();
        document.querySelectorAll<HTMLButtonElement>('[data-reader-action]').forEach((button) => {
          button.addEventListener('click', () => {
            const action = button.dataset.readerAction;
            if (action === 'narrow') width = Math.max(32, width - 4);
            if (action === 'wide') width = Math.min(60, width + 4);
            if (action === 'smaller') scale = Math.max(0.85, Number((scale - 0.05).toFixed(2)));
            if (action === 'larger') scale = Math.min(1.3, Number((scale + 0.05).toFixed(2)));
            localStorage.setItem('bookstacks-reader-width', String(width));
            localStorage.setItem('bookstacks-reader-scale', String(scale));
            applyReaderSettings();
          });
        });
      </script>
    </>
  )}
</BaseLayout>
