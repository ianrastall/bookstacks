---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { relativeUrl } from '../../utils/relativeUrl';
import TocTree from '../../components/TocTree.astro';

export async function getStaticPaths() {
  const entries = await getCollection('authors');
  return entries.map(entry => {
    let slug = entry.id;
    if (slug.endsWith('/index')) {
      slug = slug.slice(0, -6);
    }
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
// No longer using Astro's render() since we have raw HTML in the data

const allEntries = await getCollection('authors');

// Imported relativeUrl

const layout = entry.data.layout;

// Human labels for chapter version toggles. Language must win over generic
// subtype names such as "translation", otherwise every translated panel can
// appear as English when several languages share subtype="translation".
const LANGUAGE_LABELS: Record<string, string> = {
  en: 'English',
  ru: 'Русский',
  de: 'Deutsch',
  fr: 'Français',
  es: 'Español',
  pt: 'Português',
  it: 'Italiano',
  la: 'Latin'
};

const VERSION_KIND_LABELS: Record<string, string> = {
  maude: 'Maude (English)',
  garnett: 'Garnett (English)',
  wyllie: 'Wyllie (English)',
  johnston: 'Johnston (English)',
  'translation-es': 'Español'
};

function versionLabel(v: { id?: string; lang?: string }) {
  const id = (v.id || '').trim();
  const lang = (v.lang || '').trim();
  const idParts = id.split('-').filter(Boolean);
  const kind = idParts.length > 0 ? idParts[idParts.length - 1] : id;

  if (id && VERSION_KIND_LABELS[id]) return VERSION_KIND_LABELS[id];
  if (kind && VERSION_KIND_LABELS[kind]) return VERSION_KIND_LABELS[kind];
  if (lang && LANGUAGE_LABELS[lang]) return LANGUAGE_LABELS[lang];
  if (id === 'translation') return 'Translation';
  if (id === 'original') return 'Original';
  return id || lang || 'Version';
}

function versionDomId(v: { id?: string; lang?: string }, index: number) {
  return [v.lang, v.id, String(index + 1)].filter(Boolean).join('-') || `version-${index + 1}`;
}

// Default the visible panel to the translation (this is an English-readership
// site); fall back to the first version if there's no explicit translation.
const versions: any[] = Array.isArray(entry.data.versions) ? entry.data.versions : [];
let versionDefault = versions.findIndex((v: any) => v.id === 'translation' || v.lang === 'en');
if (versionDefault < 0) versionDefault = 0;

// An author has a portrait if public/img/authors/<slug>.png exists.
const authorSlugForPortrait = entry.id.replace('/index', '');
const portrait = fs.existsSync(`public/img/authors/${authorSlugForPortrait}.png`)
  ? relativeUrl(`img/authors/${authorSlugForPortrait}.png`)
  : null;

let books: any[] = [];
let chapters: any[] = [];
let previousChapter = null;
let nextChapter = null;
let authorSlug = '';
let bookSlug = '';

if (layout === 'author_index') {
  const currentAuthorSlug = entry.id.replace('/index', '');
  books = allEntries
    .filter(e => e.data.layout === 'book_index' && e.id.startsWith(currentAuthorSlug + '/'))
    .sort((a, b) => (a.data.book_title || '').localeCompare(b.data.book_title || ''));
} else if (layout === 'book_index' || layout === 'book') {
  const parts = entry.id.split('/');
  authorSlug = parts[0];
  bookSlug = parts[1];
  const currentBookPrefix = `${authorSlug}/${bookSlug}/`;
  
  chapters = allEntries
    .filter(e => e.data.layout === 'book' && e.id.startsWith(currentBookPrefix))
    .sort((a, b) => (a.data.chapter_order || 0) - (b.data.chapter_order || 0));

  if (layout === 'book') {
    const currentIndex = chapters.findIndex(c => c.id === entry.id);
    if (currentIndex > 0) previousChapter = chapters[currentIndex - 1];
    if (currentIndex < chapters.length - 1) nextChapter = chapters[currentIndex + 1];
  }
}

const tocRoots = Array.isArray(entry.data.tocTree)
  ? entry.data.tocTree
  : chapters.map((chapter) => ({
      labels: [chapter.data.title || chapter.id],
      children: [],
      chapter: { id: chapter.id }
    }));
---

<BaseLayout title={entry.data.title || 'Bookstacks'}>
  {layout === 'author_index' && (
    <section class="tool-container shell">
      <div class="tool-header">
        <div class="tool-title">
          <span class="material-icons">person</span>
          <div>
            <h2>{entry.data.author_name}</h2>
            {entry.data.author_dates && (
              <p class="author-dates">{entry.data.author_dates.replace(/-/g, '–')}</p>
            )}
          </div>
        </div>
        <div class="tool-actions">
          <a class="btn btn-secondary btn-compact" href={relativeUrl('')}>
            <span class="material-icons">home</span>
            Home
          </a>
        </div>
      </div>
      <p class="tool-description">Books by {entry.data.author_name}</p>
      
      {portrait && (
        <div class="author-hero">
          <img src={portrait} alt={`Portrait of ${entry.data.author_name}`} class="author-portrait" width="500" height="500" />
        </div>
      )}
      
      <div class="tool-grid">
        {books.map(book => {
          let bSlug = book.id;
          if (bSlug.endsWith('/index')) bSlug = bSlug.slice(0, -6);
          return (
            <a class="tool-card" href={relativeUrl(`authors/${bSlug}`)}>
              <div class="tool-icon">
                <span class="material-icons">menu_book</span>
              </div>
              <h3>{book.data.book_title}</h3>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {layout === 'book_index' && (
    <section class="tool-container shell">
      <div class="tool-header">
        <div class="tool-title">
          <span class="material-icons">menu_book</span>
          <h2>{entry.data.book_title}</h2>
        </div>
        <div class="tool-actions">
          <a class="btn btn-secondary btn-compact" href={relativeUrl(`authors/${authorSlug}`)}>
            <span class="material-icons">person</span>
            {entry.data.author}
          </a>
        </div>
      </div>
      <p class="tool-description">By {entry.data.author}</p>

      {entry.data.persons && Object.keys(entry.data.persons).length > 0 && (
        <details class="tei-registry">
          <summary>Characters ({Object.keys(entry.data.persons).length})</summary>
          <ul>
            {Object.entries(entry.data.persons).map(([id, person]: [string, any]) => (
              <li id={id}>
                <strong>{person.name}</strong>
                {person.note && <span> — {person.note}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}

      {entry.data.places && Object.keys(entry.data.places).length > 0 && (
        <details class="tei-registry">
          <summary>Places ({Object.keys(entry.data.places).length})</summary>
          <ul>
            {Object.entries(entry.data.places).map(([id, place]: [string, any]) => (
              <li id={id}>
                <strong>{place.name}</strong>
                {place.note && <span> — {place.note}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="toc-tree">
        <TocTree nodes={tocRoots} />
      </div>
    </section>
  )}

  {layout === 'book' && (
    <section class="tool-container chapter-container shell">
      <div class="tool-header chapter-header">
        <nav class="chapter-breadcrumbs chapter-breadcrumbs-inline" aria-label="Breadcrumb">
          <a href={relativeUrl('')}>Home</a>
          <span aria-hidden="true">/</span>
          <a href={relativeUrl(`authors/${authorSlug}`)}>{entry.data.author}</a>
          <span aria-hidden="true">/</span>
          <a href={relativeUrl(`authors/${authorSlug}/${bookSlug}`)}>{entry.data.book}</a>
        </nav>
      </div>

      <div class="chapter-layout">
        <article class="reader-content">
          {entry.data.versions && entry.data.versions.length > 0 ? (
            <div class="version-reader">
              <div class="version-toggle" role="tablist" aria-label="Text version">
                {entry.data.versions.map((v: any, i: number) => {
                  const domId = versionDomId(v, i);
                  return (
                    <button
                      class:list={["version-tab", { active: i === versionDefault }]}
                      type="button"
                      role="tab"
                      aria-selected={i === versionDefault ? 'true' : 'false'}
                      data-version={domId}
                    >{versionLabel(v)}</button>
                  );
                })}
              </div>
              {entry.data.versions.map((v: any, i: number) => {
                const domId = versionDomId(v, i);
                return (
                  <div class="version-panel" data-version={domId} lang={v.lang} hidden={i !== versionDefault} set:html={v.html} />
                );
              })}
            </div>
          ) : (
            <div set:html={entry.data.html} />
          )}
        </article>

        <aside class="chapter-sidebar">
          <nav class="chapter-navigation" aria-label="Chapter navigation">
            {previousChapter ? (
              <a class="btn btn-secondary chapter-nav-button" href={relativeUrl(`authors/${previousChapter.id}`)}>
                <span class="material-icons" aria-hidden="true">arrow_back</span>
                Previous
              </a>
            ) : (
              <span class="btn btn-secondary chapter-nav-button is-disabled" aria-disabled="true">
                <span class="material-icons" aria-hidden="true">arrow_back</span>
                Previous
              </span>
            )}

            <a class="btn btn-primary chapter-nav-button" href={relativeUrl(`authors/${authorSlug}/${bookSlug}`)}>
              <span class="material-icons" aria-hidden="true">menu_book</span>
              Contents
            </a>

            {nextChapter ? (
              <a class="btn btn-secondary chapter-nav-button" href={relativeUrl(`authors/${nextChapter.id}`)}>
                Next
                <span class="material-icons" aria-hidden="true">arrow_forward</span>
              </a>
            ) : (
              <span class="btn btn-secondary chapter-nav-button is-disabled" aria-disabled="true">
                Next
                <span class="material-icons" aria-hidden="true">arrow_forward</span>
              </span>
            )}
          </nav>
        </aside>
      </div>
    </section>
  )}

  <script>
    // Chapter version toggle: fully switch between text versions (e.g. original
    // facing translation). Only one panel is shown at a time.
    document.querySelectorAll('.version-reader').forEach((reader) => {
      const tabs = reader.querySelectorAll<HTMLButtonElement>('.version-tab');
      const panels = reader.querySelectorAll<HTMLElement>('.version-panel');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.dataset.version;
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach((p) => { p.hidden = p.dataset.version !== id; });
        });
      });
    });
  </script>
</BaseLayout>
