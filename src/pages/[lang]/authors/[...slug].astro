---
import AuthorPage from '../../../components/AuthorPage.astro';
import T from '../../../components/InterfaceText.astro';
import TocTree from '../../../components/TocTree.astro';
import EditionDownloads from '../../../components/EditionDownloads.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  editionForLocale,
  getLibrary,
  localizedEditionHref,
  localizedUnitHref,
  type Author,
  type Edition,
  type ReadingUnit,
  type Work,
} from '../../../lib/library';
import { SUPPORTED_LANGUAGES, languageData, ui, type Locale } from '../../../lib/i18n';

type Page =
  | { kind: 'author'; locale: Locale; author: Author }
  | { kind: 'edition'; locale: Locale; author: Author; work: Work; edition: Edition }
  | { kind: 'reader'; locale: Locale; author: Author; work: Work; edition: Edition; unit: ReadingUnit };

interface Props { page: Page }

export function getStaticPaths() {
  const paths: Array<{ params: { lang: string; slug: string }; props: Props }> = [];
  for (const language of SUPPORTED_LANGUAGES) {
    const locale = language.code;
    for (const author of getLibrary().authors) {
      const works = author.works.filter((work) => editionForLocale(work, locale));
      if (!works.length) continue;
      paths.push({ params: { lang: locale, slug: author.slug }, props: { page: { kind: 'author', locale, author } } });
      for (const work of works) {
        const edition = editionForLocale(work, locale)!;
        paths.push({
          params: { lang: locale, slug: `${author.slug}/${work.slug}` },
          props: { page: { kind: 'edition', locale, author, work, edition } },
        });
        for (const unit of edition.units) {
          paths.push({
            params: { lang: locale, slug: `${author.slug}/${work.slug}/${unit.path}` },
            props: { page: { kind: 'reader', locale, author, work, edition, unit } },
          });
        }
      }
    }
  }
  return paths;
}

const { page } = Astro.props;
const { locale } = page;
const labels = ui(locale);
const title = page.kind === 'author' ? page.author.name : page.kind === 'edition' ? page.edition.sourceTitle : `${page.unit.title} · ${page.edition.sourceTitle}`;
const description = page.kind === 'author'
  ? labels.booksBy(page.author.name)
  : page.kind === 'edition'
    ? `${page.edition.sourceTitle} · ${labels.byAuthor(page.author.name)}`
    : `${page.unit.title} · ${page.edition.sourceTitle}`;
---

{page.kind === 'author' ? <AuthorPage author={page.author} locale={locale} /> : <BaseLayout title={title} description={description} locale={locale} wide={page.kind === 'reader'}>
  {page.kind === 'edition' && (
    <section class="tool-container shell">
      <div class="tool-header">
        <div class="tool-title">
          <span class="material-icons" aria-hidden="true">menu_book</span>
          <div>
            <h1 lang={page.edition.code} translate="no">{page.edition.sourceTitle}</h1>
            <p class="tool-description"><T locale={locale} k="byAuthor" args={[page.author.name]} /></p>
          </div>
        </div>
        <div class="tool-actions">
          <a class="btn btn-secondary btn-compact" href={`/authors/${page.author.slug}`}>
            <span class="material-icons" aria-hidden="true">person</span>{page.author.name}
          </a>
        </div>
      </div>
      <p class="edition-note"><T locale={locale} k="editionStructureNote" /></p>
      {page.edition.sourceDescription && (
        <aside class="edition-source-note">
          <strong><T locale={locale} k="sources" /></strong>
          <p lang={page.edition.code} translate="no">{page.edition.sourceDescription}</p>
          <ul>{page.edition.sourceLinks.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>
        </aside>
      )}
      <article class="edition-panel edition-contents">
        <header class="edition-header">
          <div>
            <span lang={page.edition.code} translate="no" class="book-status book-status-original"><span class="material-icons" aria-hidden="true">translate</span>{languageData(locale).nativeName}</span>
            <h2 lang={page.edition.code} translate="no">{page.edition.sourceTitle}</h2>
            <p><T locale={locale} k="readingUnitCount" args={[page.edition.units.length]} /></p>
          </div>
          <div class="edition-actions">
            {page.edition.units[0] && <a class="btn btn-primary btn-compact" href={localizedUnitHref(page.work, page.edition, page.edition.units[0])}><span class="material-icons" aria-hidden="true">auto_stories</span><T locale={locale} k="startReading" /></a>}
            <a class="btn btn-secondary btn-compact" href="#downloads"><span class="material-icons" aria-hidden="true">download</span><T locale={locale} k="downloads" /></a>
          </div>
        </header>
        {page.work.editions.length > 1 && <details class="other-editions">
          <summary><T locale={locale} k="otherEditions" /></summary>
          <ul>{page.work.editions.filter(edition=>edition.code!==locale).map(edition=><li><a href={localizedEditionHref(page.work,edition)} lang={edition.code} translate="no">{edition.sourceTitle}</a></li>)}</ul>
        </details>}
        <div class="toc-tree">
          <h3><T locale={locale} k="contents" /></h3>
          <div lang={page.edition.code} translate="no"><TocTree nodes={page.edition.toc} /></div>
        </div>
        {(page.edition.persons.length > 0 || page.edition.places.length > 0) && (
          <details class="tei-registry">
            <summary><T locale={locale} k="registries" args={[page.edition.persons.length, page.edition.places.length]} /></summary>
            <div class="registry-columns">
              {page.edition.persons.length > 0 && <section><h3><T locale={locale} k="people" /></h3><dl>{page.edition.persons.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>}
              {page.edition.places.length > 0 && <section><h3><T locale={locale} k="places" /></h3><dl>{page.edition.places.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>}
            </div>
          </details>
        )}
      </article>
      <EditionDownloads author={page.author} work={page.work} edition={page.edition} locale={locale} />
    </section>
  )}

  {page.kind === 'reader' && (
    <section class="chapter-container shell">
      <header class="chapter-header">
        <nav class="chapter-breadcrumbs" aria-label={labels.contents} data-i18n-aria-label="contents">
          <a href="/"><T locale={locale} k="library" /></a><span>/</span><a href={`/authors/${page.author.slug}`}>{page.author.name}</a><span>/</span><a href={localizedEditionHref(page.work, page.edition)}>{page.edition.sourceTitle}</a>
        </nav>
        <p lang={page.edition.code} translate="no" class="reader-context">{page.unit.context.join(' · ')}</p>
        <h1 lang={page.edition.code} translate="no">{page.unit.title}</h1>
      </header>
      <div class="chapter-layout">
        <article lang={page.edition.code} translate="no" class="reader-content" set:html={page.unit.html} />
        <aside class="chapter-sidebar" aria-label={labels.readingControls} data-i18n-aria-label="readingControls">
          <details class="reader-controls panel" open><summary><T locale={locale} k="readingControls" /></summary>
            <strong lang={page.edition.code} translate="no">{page.edition.sourceTitle}</strong>
            {page.work.editions.length > 1 && (
              <details class="other-editions">
                <summary><T locale={locale} k="otherEditions" /></summary>
                <ul>
                  {page.work.editions.filter((edition) => edition.code !== locale).map((edition) => (
                    <li><a href={localizedEditionHref(page.work, edition)} lang={edition.code} translate="no">{edition.sourceTitle}</a></li>
                  ))}
                </ul>
              </details>
            )}
            <div class="reader-display">
              <span><T locale={locale} k="textWidth" /></span>
              <button type="button" data-reader-action="narrow" aria-label={labels.narrowText} data-i18n-aria-label="narrowText">−</button>
              <button type="button" data-reader-action="wide" aria-label={labels.widenText} data-i18n-aria-label="widenText">+</button>
              <span><T locale={locale} k="textSize" /></span>
              <button type="button" data-reader-action="smaller" aria-label={labels.decreaseText} data-i18n-aria-label="decreaseText">A−</button>
              <button type="button" data-reader-action="larger" aria-label={labels.increaseText} data-i18n-aria-label="increaseText">A+</button>
            </div>
            <div class="reader-font-controls">
              <label class="reader-font-picker">
                <span><T locale={locale} k="serifCascade" /></span>
                <select data-reader-font="serif" aria-describedby="reader-font-note">
                  <option value="classic">Constantia, Georgia, Times</option>
                  <option value="charter">Charter, Cambria, Constantia</option>
                  <option value="old-style">Iowan Old Style, Baskerville, Palatino</option>
                  <option value="garamond">Garamond, Constantia, Georgia</option>
                  <option value="platform">ui-serif, Georgia, Cambria</option>
                  <option value="times">Times New Roman, Liberation Serif</option>
                </select>
              </label>
              <label class="reader-font-picker">
                <span><T locale={locale} k="sansCascade" /></span>
                <select data-reader-font="sans" aria-describedby="reader-font-note">
                  <option value="office">Segoe UI, Calibri, Arial</option>
                  <option value="system">System UI, Segoe UI</option>
                  <option value="helvetica">Helvetica Neue, Helvetica, Arial</option>
                  <option value="humanist">Avenir Next, Gill Sans, Calibri</option>
                  <option value="screen">Verdana, Geneva, Tahoma</option>
                  <option value="trebuchet">Trebuchet MS, Tahoma, Segoe UI</option>
                </select>
              </label>
              <p class="reader-font-note" id="reader-font-note"><T locale={locale} k="fontNote" /></p>
            </div>
          </details>
          <nav class="chapter-navigation" aria-label={labels.readingOrder} data-i18n-aria-label="readingOrder">
            {page.unit.previousPath ? <a class="btn btn-secondary chapter-nav-button" rel="prev" href={`${localizedEditionHref(page.work, page.edition)}/${page.unit.previousPath}`}><span class="material-icons" aria-hidden="true">arrow_back</span><T locale={locale} k="previous" /></a> : <span class="btn btn-secondary chapter-nav-button is-disabled"><T locale={locale} k="previous" /></span>}
            <a class="btn btn-secondary chapter-nav-button" href={localizedEditionHref(page.work, page.edition)}><span class="material-icons" aria-hidden="true">list</span><T locale={locale} k="contents" /></a>
            {page.unit.nextPath ? <a class="btn btn-primary chapter-nav-button" rel="next" href={`${localizedEditionHref(page.work, page.edition)}/${page.unit.nextPath}`}><T locale={locale} k="next" /><span class="material-icons" aria-hidden="true">arrow_forward</span></a> : <span class="btn btn-primary chapter-nav-button is-disabled"><T locale={locale} k="next" /></span>}
          </nav>
        </aside>
      </div>
      <script>
        const readerRoot = document.documentElement;
        const controls=document.querySelector<HTMLDetailsElement>('.reader-controls')!;
        const compact=matchMedia('(max-width:760px)');controls.open=!compact.matches;compact.addEventListener('change',()=>controls.open=!compact.matches);
        const readSetting=(key:string)=>{try{return localStorage.getItem(key);}catch{return null;}};
        const saveSetting=(key:string,value:string)=>{try{localStorage.setItem(key,value);}catch{/* Settings still apply for this page. */}};
        let width = Number(readSetting('bookstacks-reader-width') || 44);
        let scale = Number(readSetting('bookstacks-reader-scale') || 1);
        const serifSelect = document.querySelector<HTMLSelectElement>('[data-reader-font="serif"]');
        const sansSelect = document.querySelector<HTMLSelectElement>('[data-reader-font="sans"]');
        const applyReaderSettings = () => {
          readerRoot.style.setProperty('--reader-width', `${width}rem`);
          readerRoot.style.setProperty('--reader-scale', String(scale));
        };
        applyReaderSettings();
        document.querySelectorAll<HTMLButtonElement>('[data-reader-action]').forEach((button) => {
          button.addEventListener('click', () => {
            const action = button.dataset.readerAction;
            if (action === 'narrow') width = Math.max(32, width - 4);
            if (action === 'wide') width = Math.min(60, width + 4);
            if (action === 'smaller') scale = Math.max(0.85, Number((scale - 0.05).toFixed(2)));
            if (action === 'larger') scale = Math.min(2, Number((scale + 0.05).toFixed(2)));
            saveSetting('bookstacks-reader-width', String(width));
            saveSetting('bookstacks-reader-scale', String(scale));
            applyReaderSettings();
          });
        });
        if (serifSelect) {
          serifSelect.value = readerRoot.dataset.readerSerif || 'classic';
          serifSelect.addEventListener('change', () => {
            readerRoot.dataset.readerSerif = serifSelect.value;
            saveSetting('bookstacks-reader-serif', serifSelect.value);
          });
        }
        if (sansSelect) {
          sansSelect.value = readerRoot.dataset.readerSans || 'office';
          sansSelect.addEventListener('change', () => {
            readerRoot.dataset.readerSans = sansSelect.value;
            saveSetting('bookstacks-reader-sans', sansSelect.value);
          });
        }

        const noteWrappers = Array.from(document.querySelectorAll<HTMLElement>('.tei-note'));
        const closeNote = (wrapper: HTMLElement) => {
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const popover = wrapper.querySelector<HTMLElement>('.tei-note-popover');
          if (!reference || !popover) return;
          wrapper.dataset.pinned = 'false';
          reference.setAttribute('aria-expanded', 'false');
          popover.hidden = true;
        };
        const openNote = (wrapper: HTMLElement, pinned = false) => {
          for (const other of noteWrappers) if (other !== wrapper) closeNote(other);
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const popover = wrapper.querySelector<HTMLElement>('.tei-note-popover');
          if (!reference || !popover) return;
          if (pinned) wrapper.dataset.pinned = 'true';
          reference.setAttribute('aria-expanded', 'true');
          popover.hidden = false;
        };
        for (const wrapper of noteWrappers) {
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const close = wrapper.querySelector<HTMLButtonElement>('.tei-note-close');
          reference?.addEventListener('mouseenter', () => openNote(wrapper));
          reference?.addEventListener('focus', () => openNote(wrapper));
          wrapper.addEventListener('mouseleave', () => {
            if (wrapper.dataset.pinned !== 'true' && !wrapper.contains(document.activeElement)) closeNote(wrapper);
          });
          reference?.addEventListener('click', () => {
            if (wrapper.dataset.pinned === 'true') closeNote(wrapper);
            else openNote(wrapper, true);
          });
          close?.addEventListener('click', () => {
            closeNote(wrapper);
            reference?.focus();
          });
        }
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          const open = noteWrappers.find((wrapper) => wrapper.querySelector<HTMLButtonElement>('.tei-note-ref')?.getAttribute('aria-expanded') === 'true');
          const reference = open?.querySelector<HTMLButtonElement>('.tei-note-ref');
          if (open) closeNote(open);
          reference?.focus();
        });
      </script>
    </section>
  )}
</BaseLayout>}
