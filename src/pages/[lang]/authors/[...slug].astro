---
import AuthorPage from '../../../components/AuthorPage.astro';
import T from '../../../components/InterfaceText.astro';
import TocTree from '../../../components/TocTree.astro';
import EditionDownloads from '../../../components/EditionDownloads.astro';
import PdfReader from '../../../components/PdfReader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  editionForLocale,
  getLibrary,
  localizedEditionHref,
  localizedUnitHref,
  pdfReadingHref,
  hasEmbeddedPdf,
  type Author,
  type Edition,
  type ReadingUnit,
  type Work,
} from '../../../lib/library';
import { EDITION_LANGUAGES, editionDirection, editionLanguageData, editionLanguageName, type EditionLanguage } from '../../../lib/i18n';
import { text } from '../../../lib/interface';

type Page =
  | { kind: 'author'; locale: EditionLanguage; author: Author }
  | { kind: 'edition'; locale: EditionLanguage; author: Author; work: Work; edition: Edition }
  | { kind: 'reader'; locale: EditionLanguage; author: Author; work: Work; edition: Edition; unit: ReadingUnit };

interface Props { page: Page }

export function getStaticPaths() {
  const paths: Array<{ params: { lang: string; slug: string }; props: Props }> = [];
  for (const language of EDITION_LANGUAGES) {
    const locale = language.code;
    for (const author of getLibrary().authors) {
      const works = author.works.filter((work) => editionForLocale(work, locale));
      if (!works.length) continue;
      paths.push({ params: { lang: locale, slug: author.slug }, props: { page: { kind: 'author', locale, author } } });
      for (const work of works) {
        const edition = editionForLocale(work, locale)!;
        paths.push({
          params: { lang: locale, slug: `${author.slug}/${work.slug}` },
          props: { page: { kind: 'edition', locale, author, work, edition } },
        });
        for (const unit of edition.units) {
          paths.push({
            params: { lang: locale, slug: `${author.slug}/${work.slug}/${unit.path}` },
            props: { page: { kind: 'reader', locale, author, work, edition, unit } },
          });
        }
      }
    }
  }
  return paths;
}

const { page } = Astro.props;
// The route language is the edition language; the interface script may replace control text afterwards.
const { locale } = page;
const t = (key: string, args: Array<string | number> = []) => text(locale, key, args);
const editionDir = page.kind === 'author' ? 'ltr' : editionDirection(page.edition.code);
const title = page.kind === 'author' ? page.author.name : page.kind === 'edition' ? page.edition.sourceTitle : `${page.unit.title} · ${page.edition.sourceTitle}`;
const description = page.kind === 'author'
  ? t('booksBy', [page.author.name])
  : page.kind === 'edition'
    ? `${page.edition.sourceTitle} · ${t('byAuthor', [page.author.name])}`
    : `${page.unit.title} · ${page.edition.sourceTitle}`;
---

{page.kind === 'author' ? <AuthorPage author={page.author} locale={locale} /> : <BaseLayout title={title} description={description} locale={locale} wide={page.kind === 'reader'}>
  {page.kind === 'edition' && (
    <section class="tool-container shell">
      <div class="tool-header">
        <div class="tool-title">
          <span class="material-icons" aria-hidden="true">menu_book</span>
          <div>
            <h1 lang={page.edition.code} dir={editionDir} translate="no">{page.edition.sourceTitle}</h1>
            <p class="tool-description"><T locale={locale} k="byAuthor" args={[page.author.name]} /></p>
          </div>
        </div>
        <div class="tool-actions">
          <a class="btn btn-secondary btn-compact" href={`/authors/${page.author.slug}`}>
            <span class="material-icons" aria-hidden="true">person</span>{page.author.name}
          </a>
        </div>
      </div>
      <p class="edition-note"><T locale={locale} k="editionStructureNote" /></p>
      {(page.edition.sourceDescription || page.edition.sourceCredits.length > 0 || page.edition.sourceLinks.length > 0) && (
        <aside class="edition-source-note">
          <strong><T locale={locale} k="sources" /></strong>
          {page.edition.sourceDescription && <p lang={page.edition.sourceDescriptionLanguage} translate="no">{page.edition.sourceDescription}</p>}
          {page.edition.sourceCredits.length > 0 && <ul class="edition-source-credits" translate="no">{page.edition.sourceCredits.map(credit => <li>{credit}</li>)}</ul>}
          <ul>{page.edition.sourceLinks.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>
        </aside>
      )}
      <article class="edition-panel edition-contents">
        <header class="edition-header">
          <div>
            <span lang={page.edition.code} dir={editionDir} translate="no" class="book-status book-status-original"><span class="material-icons" aria-hidden="true">translate</span>{editionLanguageData(locale).nativeName}</span>
            <h2 lang={page.edition.code} dir={editionDir} translate="no">{page.edition.sourceTitle}</h2>
            <p><T locale={locale} k="readingUnitCount" args={[page.edition.units.length]} /></p>
          </div>
          <div class="edition-actions">
            {page.edition.units[0] && <a class="btn btn-primary btn-compact" href={localizedUnitHref(page.work, page.edition, page.edition.units[0])}><span class="material-icons" aria-hidden="true">auto_stories</span><T locale={locale} k="readOnline" /></a>}
            {hasEmbeddedPdf(page.edition) && <a class="btn btn-secondary btn-compact reader-start-pdf" href={pdfReadingHref(page.work,page.edition)}><T locale={locale} k="readPdf" /></a>}
            <a class="btn btn-secondary btn-compact" href="#downloads"><span class="material-icons" aria-hidden="true">download</span><T locale={locale} k="downloads" /></a>
          </div>
        </header>
        {page.work.editions.length > 1 && <details class="other-editions">
          <summary><T locale={locale} k="otherEditions" /></summary>
          <ul>{page.work.editions.filter(edition=>edition.code!==locale).map(edition=><li><a href={localizedEditionHref(page.work,edition)} lang={edition.code} dir={editionDirection(edition.code)} translate="no">{edition.sourceTitle} <span class="edition-language">({editionLanguageName(edition)})</span></a></li>)}</ul>
        </details>}
        <div class="toc-tree">
          <h3><T locale={locale} k="contents" /></h3>
          <div lang={page.edition.code} dir={editionDir} translate="no"><TocTree nodes={page.edition.toc} /></div>
        </div>
        {(page.edition.persons.length > 0 || page.edition.places.length > 0) && (
          <details class="tei-registry">
            <summary><T locale={locale} k="registries" args={[page.edition.persons.length, page.edition.places.length]} /></summary>
            <div class="registry-columns">
              {page.edition.persons.length > 0 && <section><h3><T locale={locale} k="people" /></h3><dl lang={page.edition.code} dir={editionDir} translate="no">{page.edition.persons.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>}
              {page.edition.places.length > 0 && <section><h3><T locale={locale} k="places" /></h3><dl lang={page.edition.code} dir={editionDir} translate="no">{page.edition.places.map((entry) => <div><dt>{entry.name}</dt>{entry.description && <dd>{entry.description}</dd>}</div>)}</dl></section>}
            </div>
          </details>
        )}
      </article>
      <EditionDownloads author={page.author} work={page.work} edition={page.edition} locale={locale} />
      <script>
        const pdfStart=document.querySelector<HTMLAnchorElement>('.reader-start-pdf');
        if(pdfStart&&location.hash==='#pdf-reader'){
          const target=new URL(pdfStart.href);
          for(const [key,value] of new URL(location.href).searchParams)if(key!=='view')target.searchParams.set(key,value);
          location.replace(target.href);
        }
      </script>
    </section>
  )}

  {page.kind === 'reader' && (
    <section class="chapter-container shell">
      <header class="chapter-header">
        <nav class="chapter-breadcrumbs" aria-label={t('contents')} data-i18n-aria-label="contents">
          <a href="/"><T locale={locale} k="library" /></a><span>/</span><a href={`/authors/${page.author.slug}`}>{page.author.name}</a><span>/</span><a href={localizedEditionHref(page.work, page.edition)}>{page.edition.sourceTitle}</a>
        </nav>
        <p lang={page.edition.code} dir={editionDir} translate="no" class="reader-context" data-online-only>{page.unit.context.join(' · ')}</p>
        <h1 lang={page.edition.code} dir={editionDir} translate="no" data-reader-title data-online-title={page.unit.title} data-pdf-title={page.edition.sourceTitle}>{page.unit.title}</h1>
      </header>
      <div class="chapter-layout">
        <div class="reader-main" data-reader-surface>
          <article id="reader-online" data-online-content lang={page.edition.code} dir={editionDir} translate="no" class="reader-content" set:html={page.unit.html} />
          <PdfReader author={page.author} edition={page.edition} locale={locale} unitTitle={page.unit.title} unitContext={page.unit.context} />
        </div>
        <aside class="chapter-sidebar" aria-label={t('readingControls')} data-i18n-aria-label="readingControls">
          <details class="reader-controls panel" open><summary><T locale={locale} k="readingControls" /></summary>
            <strong lang={page.edition.code} dir={editionDir} translate="no">{page.edition.sourceTitle}</strong>
            {page.work.editions.length > 1 && (
              <details class="other-editions">
                <summary><T locale={locale} k="otherEditions" /></summary>
                <ul>
                  {page.work.editions.filter((edition) => edition.code !== locale).map((edition) => (
                    <li><a href={localizedEditionHref(page.work, edition)} lang={edition.code} dir={editionDirection(edition.code)} translate="no">{edition.sourceTitle} <span class="edition-language">({editionLanguageName(edition)})</span></a></li>
                  ))}
                </ul>
              </details>
            )}
            {hasEmbeddedPdf(page.edition) && <div class="reading-mode" role="group" aria-label={t('readingControls')} data-i18n-aria-label="readingControls">
              <button type="button" data-reading-mode="online" aria-pressed="true" aria-controls="reader-online" disabled><T locale={locale} k="readOnline" /></button>
              {hasEmbeddedPdf(page.edition)&&<button type="button" data-reading-mode="pdf" aria-pressed="false" aria-controls="pdf-reader" disabled><T locale={locale} k="readPdf" /></button>}
            </div>}
            <button type="button" class="reader-fullscreen" aria-pressed="false" data-online-only disabled><T locale={locale} k="fullscreen" /></button>
            <div class="reader-display" data-online-only>
              <span><T locale={locale} k="textWidth" /></span>
              <button type="button" data-reader-action="narrow" aria-label={t('narrowText')} data-i18n-aria-label="narrowText">−</button>
              <button type="button" data-reader-action="wide" aria-label={t('widenText')} data-i18n-aria-label="widenText">+</button>
              <span><T locale={locale} k="textSize" /></span>
              <button type="button" data-reader-action="smaller" dir="ltr" aria-label={t('decreaseText')} data-i18n-aria-label="decreaseText">A−</button>
              <button type="button" data-reader-action="larger" dir="ltr" aria-label={t('increaseText')} data-i18n-aria-label="increaseText">A+</button>
            </div>
            <div class="reader-font-controls" data-online-only>
              <label class="reader-font-picker">
                <span><T locale={locale} k="serifCascade" /></span>
                <select data-reader-font="serif" dir="ltr" autocomplete="off" aria-describedby="reader-font-note">
                  <option value="" disabled>—</option>
                  <option value="classic" selected>Constantia, Georgia, Times</option>
                  <option value="charter">Charter, Cambria, Constantia</option>
                  <option value="old-style">Iowan Old Style, Baskerville, Palatino</option>
                  <option value="garamond">Garamond, Constantia, Georgia</option>
                  <option value="platform">ui-serif, Georgia, Cambria</option>
                  <option value="times">Times New Roman, Liberation Serif</option>
                </select>
              </label>
              <label class="reader-font-picker">
                <span><T locale={locale} k="sansCascade" /></span>
                <select data-reader-font="sans" dir="ltr" autocomplete="off" aria-describedby="reader-font-note">
                  <option value="" disabled selected>—</option>
                  <option value="office">Segoe UI, Calibri, Arial</option>
                  <option value="system">System UI, Segoe UI</option>
                  <option value="helvetica">Helvetica Neue, Helvetica, Arial</option>
                  <option value="humanist">Avenir Next, Gill Sans, Calibri</option>
                  <option value="screen">Verdana, Geneva, Tahoma</option>
                  <option value="trebuchet">Trebuchet MS, Tahoma, Segoe UI</option>
                </select>
              </label>
              <p class="reader-font-note" id="reader-font-note"><T locale={locale} k="fontNote" /></p>
            </div>
          </details>
          <nav class="chapter-navigation" data-online-only aria-label={t('readingOrder')} data-i18n-aria-label="readingOrder">
            {page.unit.previousPath ? <a class="btn btn-secondary chapter-nav-button" rel="prev" href={`${localizedEditionHref(page.work, page.edition)}/${page.unit.previousPath}`}><span class="material-icons directional-icon" aria-hidden="true">arrow_back</span><T locale={locale} k="previous" /></a> : <span class="btn btn-secondary chapter-nav-button is-disabled"><T locale={locale} k="previous" /></span>}
            <a class="btn btn-secondary chapter-nav-button" href={localizedEditionHref(page.work, page.edition)}><span class="material-icons" aria-hidden="true">list</span><T locale={locale} k="contents" /></a>
            {page.unit.nextPath ? <a class="btn btn-primary chapter-nav-button" rel="next" href={`${localizedEditionHref(page.work, page.edition)}/${page.unit.nextPath}`}><T locale={locale} k="next" /><span class="material-icons directional-icon" aria-hidden="true">arrow_forward</span></a> : <span class="btn btn-primary chapter-nav-button is-disabled"><T locale={locale} k="next" /></span>}
          </nav>
          {page.unit.illustration && (
            <figure class="reader-illustration tei-engraving" data-online-only lang={page.edition.code} dir={editionDir} translate="no">
              <img class="tei-graphic" src={page.unit.illustration.previewSrc ?? page.unit.illustration.src} alt={page.unit.illustration.description} width="640" height="427" loading="lazy" decoding="async" />
            </figure>
          )}
        </aside>
      </div>
      <script>
        import { currentLocale, text } from '../../../lib/interface';
        const readerRoot = document.documentElement;
        const controls=document.querySelector<HTMLDetailsElement>('.reader-controls')!;
        const compact=matchMedia('(max-width:760px)');controls.open=!compact.matches;compact.addEventListener('change',()=>controls.open=!compact.matches);
        const readSetting=(key:string)=>{try{return localStorage.getItem(key);}catch{return null;}};
        const saveSetting=(key:string,value:string)=>{try{localStorage.setItem(key,value);}catch{/* Settings still apply for this page. */}};
        const savedWidth = Number(readSetting('bookstacks-reader-width') || 44);
        let width = Number.isFinite(savedWidth) ? Math.min(100, Math.max(32, savedWidth)) : 44;
        const savedScale = Number(readSetting('bookstacks-reader-scale') || 1);
        let scale = Number.isFinite(savedScale) ? Math.min(2, Math.max(0.85, savedScale)) : 1;
        const serifSelect = document.querySelector<HTMLSelectElement>('[data-reader-font="serif"]');
        const sansSelect = document.querySelector<HTMLSelectElement>('[data-reader-font="sans"]');
        const applyReaderSettings = () => {
          readerRoot.style.setProperty('--reader-width', `${width}rem`);
          readerRoot.style.setProperty('--reader-scale', String(scale));
        };
        applyReaderSettings();
        document.querySelectorAll<HTMLButtonElement>('[data-reader-action]').forEach((button) => {
          button.addEventListener('click', () => {
            const action = button.dataset.readerAction;
            if (action === 'narrow') width = Math.max(32, width - 4);
            if (action === 'wide') width = Math.min(100, width + 4);
            if (action === 'smaller') scale = Math.max(0.85, Number((scale - 0.05).toFixed(2)));
            if (action === 'larger') scale = Math.min(2, Number((scale + 0.05).toFixed(2)));
            saveSetting('bookstacks-reader-width', String(width));
            saveSetting('bookstacks-reader-scale', String(scale));
            applyReaderSettings();
          });
        });
        const applyReaderFont = (family: 'serif' | 'sans', cascade: string) => {
          readerRoot.dataset.readerFamily = family;
          if (family === 'serif') {
            readerRoot.dataset.readerSerif = cascade;
            delete readerRoot.dataset.readerSans;
          } else readerRoot.dataset.readerSans = cascade;
          if (serifSelect) serifSelect.value = family === 'serif' ? cascade : '';
          if (sansSelect) sansSelect.value = family === 'sans' ? cascade : '';
        };
        const restoreReaderFont = () => {
          let saved: string | null = null;
          try { saved = sessionStorage.getItem('bookstacks-reader-font'); } catch { /* Optional storage. */ }
          const [family, cascade] = (saved || '').split(':');
          const select = family === 'serif' ? serifSelect : family === 'sans' ? sansSelect : null;
          if (select && [...select.options].some(option => option.value === cascade && !option.disabled)) {
            applyReaderFont(family as 'serif' | 'sans', cascade);
          } else applyReaderFont('serif', 'classic');
        };
        const chooseReaderFont = (family: 'serif' | 'sans', cascade: string) => {
          applyReaderFont(family, cascade);
          try { sessionStorage.setItem('bookstacks-reader-font', `${family}:${cascade}`); } catch { /* Applied for this page. */ }
        };
        restoreReaderFont();
        // History restoration must use the session's latest choice, not stale form values.
        window.addEventListener('pageshow', restoreReaderFont);
        if (serifSelect && sansSelect) {
          serifSelect.addEventListener('change', () => {
            chooseReaderFont('serif', serifSelect.value);
          });
          sansSelect.addEventListener('change', () => {
            chooseReaderFont('sans', sansSelect.value);
          });
        }

        const reader = document.querySelector<HTMLElement>('.chapter-container')!;
        const fullscreen = document.querySelector<HTMLButtonElement>('.reader-fullscreen')!;
        const fullscreenLabel = fullscreen.querySelector<HTMLElement>('[data-i18n]')!;
        const setFullscreen = (active: boolean) => {
          reader.classList.toggle('reader-expanded', active);
          document.body.classList.toggle('reader-fullscreen-active', active);
          fullscreen.setAttribute('aria-pressed', String(active));
          for (const sibling of document.body.children) {
            if (sibling instanceof HTMLElement && sibling.tagName !== 'MAIN' && !['SCRIPT', 'STYLE'].includes(sibling.tagName)) sibling.inert = active;
          }
          if (active) { reader.setAttribute('role', 'dialog'); reader.setAttribute('aria-modal', 'true'); }
          else { reader.removeAttribute('role'); reader.removeAttribute('aria-modal'); }

          fullscreenLabel.dataset.i18n = active ? 'exitFullscreen' : 'fullscreen';
          updateFullscreenLabel();
        };
        const updateFullscreenLabel = () => {
          fullscreenLabel.textContent = text(currentLocale() ?? 'en', fullscreenLabel.dataset.i18n!);
        };
        reader.setAttribute('aria-label', controls.querySelector('strong')!.textContent!);
        fullscreen.disabled = false;
        fullscreen.addEventListener('click', async () => {
          if (reader.classList.contains('reader-expanded')) {
            if (document.fullscreenElement) await document.exitFullscreen().catch(() => {});
            setFullscreen(false);
          } else {
            setFullscreen(true); fullscreen.focus();
            if (document.fullscreenEnabled) await reader.requestFullscreen().catch(() => {});
          }
        });
        document.addEventListener('fullscreenchange', () => {
          if (!document.fullscreenElement) { setFullscreen(false); fullscreen.focus(); }
        });
        document.addEventListener('interfacechange', updateFullscreenLabel);
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && reader.classList.contains('reader-expanded') && !document.fullscreenElement) {
            setFullscreen(false); fullscreen.focus();
          }
        });

        const noteWrappers = Array.from(document.querySelectorAll<HTMLElement>('.tei-note'));
        const closeNote = (wrapper: HTMLElement) => {
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const popover = wrapper.querySelector<HTMLElement>('.tei-note-popover');
          if (!reference || !popover) return;
          wrapper.dataset.pinned = 'false';
          reference.setAttribute('aria-expanded', 'false');
          popover.hidden = true;
        };
        const openNote = (wrapper: HTMLElement, pinned = false) => {
          for (const other of noteWrappers) if (other !== wrapper) closeNote(other);
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const popover = wrapper.querySelector<HTMLElement>('.tei-note-popover');
          if (!reference || !popover) return;
          if (pinned) wrapper.dataset.pinned = 'true';
          reference.setAttribute('aria-expanded', 'true');
          popover.hidden = false;
        };
        for (const wrapper of noteWrappers) {
          const reference = wrapper.querySelector<HTMLButtonElement>('.tei-note-ref');
          const close = wrapper.querySelector<HTMLButtonElement>('.tei-note-close');
          reference?.addEventListener('mouseenter', () => openNote(wrapper));
          reference?.addEventListener('focus', () => openNote(wrapper));
          wrapper.addEventListener('mouseleave', () => {
            if (wrapper.dataset.pinned !== 'true' && !wrapper.contains(document.activeElement)) closeNote(wrapper);
          });
          reference?.addEventListener('click', () => {
            if (wrapper.dataset.pinned === 'true') closeNote(wrapper);
            else openNote(wrapper, true);
          });
          close?.addEventListener('click', () => {
            closeNote(wrapper);
            reference?.focus();
          });
        }
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          const open = noteWrappers.find((wrapper) => wrapper.querySelector<HTMLButtonElement>('.tei-note-ref')?.getAttribute('aria-expanded') === 'true');
          const reference = open?.querySelector<HTMLButtonElement>('.tei-note-ref');
          if (open) closeNote(open);
          reference?.focus();
        });
      </script>
    </section>
  )}
</BaseLayout>}
