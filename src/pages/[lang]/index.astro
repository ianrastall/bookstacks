---
import Catalogue from '../../components/Catalogue.astro';
import { INTERFACE_LOCALES, type Locale } from '../../lib/i18n';
// Static localized catalogues serve browsers without JavaScript; the catalogue itself is never filtered.
export function getStaticPaths() { return INTERFACE_LOCALES.map(language=>({params:{lang:language.code}})); }
const locale=Astro.params.lang as Locale;
---
<Catalogue locale={locale} />
